    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if seat then
        seat.AssemblyLinearVelocity = seat.CFrame.LookVector * (seat.AssemblyLinearVelocity.Magnitude + 100)
    end
end)

SmoothFloatBtn.MouseButton1Click:Connect(function()
    if not isFeaturesActive then return end
    isSmoothBoosting = not isSmoothBoosting
    SmoothFloatBtn.Text = isSmoothBoosting and "🔥" or "⚡"
    
    if isSmoothBoosting then
        task.spawn(function()
            while isSmoothBoosting and isFeaturesActive do
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local seat = hum and hum.SeatPart
                
                if seat and seat:IsA("BasePart") then
                    seat.AssemblyLinearVelocity = seat.AssemblyLinearVelocity + (seat.CFrame.LookVector * 3.5)
                else
                    isSmoothBoosting = false
                    SmoothFloatBtn.Text = "⚡"
                    break
                end
                task.wait(0.03)
            end
        end)
    end
end)

SmoothReverseFloatBtn.MouseButton1Click:Connect(function()
    if not isFeaturesActive then return end
    isSmoothReversing = not isSmoothReversing
    SmoothReverseFloatBtn.Text = isSmoothReversing and "💥" or "🛑"
    
    if isSmoothReversing then
        task.spawn(function()
            while isSmoothReversing and isFeaturesActive do
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local seat = hum and hum.SeatPart
                
                if seat and seat:IsA("BasePart") then
                    local currentVel = seat.AssemblyLinearVelocity
                    local forwardSpeed = currentVel:Dot(seat.CFrame.LookVector)
                    
                    if forwardSpeed > 0 then
                        local newVel = currentVel - (seat.CFrame.LookVector * 4)
                        if newVel:Dot(seat.CFrame.LookVector) < 0 then
                            seat.AssemblyLinearVelocity = Vector3.zero
                        else
                            seat.AssemblyLinearVelocity = newVel
                        end
                    elseif forwardSpeed > -1 then
                        seat.AssemblyLinearVelocity = Vector3.zero
                    end
                else
                    isSmoothReversing = false
                    SmoothReverseFloatBtn.Text = "🛑"
                    break
                end
                task.wait(0.0225)
            end
        end)
    end
end)

