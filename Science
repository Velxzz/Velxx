UserInputService.InputBegan:Connect(function(input)
    if not isFeaturesActive then return end
    
    if input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then
        isRightPressed = true
    elseif input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then
        isLeftPressed = true
    end

    if not settingTarget then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        local guiObjects = LocalPlayer.PlayerGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
        
        for _, gui in ipairs(guiObjects) do
            if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and gui ~= RightSetBtn and gui ~= LeftSetBtn and gui ~= MenuShortcut then
                
                gui.MouseButton1Down:Connect(function()
                    if settingTarget == nil then
                        if gui == boundRightButton then isRightPressed = true end
                        if gui == boundLeftButton then isLeftPressed = true end
                    end
                end)
                
                gui.MouseButton1Up:Connect(function()
                    if gui == boundRightButton then isRightPressed = false end
                    if gui == boundLeftButton then isLeftPressed = false end
                end)

                if settingTarget == "Right" then
                    boundRightButton = gui
                    RightSetBtn.Text = "Saved!"
                    RightSetBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                elseif settingTarget == "Left" then
                    boundLeftButton = gui
                    LeftSetBtn.Text = "Saved!"
                    LeftSetBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                end
                
                settingTarget = nil
                break
            end
        end
    end
end)

