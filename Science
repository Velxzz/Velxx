RunService.RenderStepped:Connect(function()
    if not isFastSteer then return end
    local controlsUI = LocalPlayer.PlayerGui:FindFirstChild("Interface") and LocalPlayer.PlayerGui.Interface:FindFirstChild("Controls")
    if not controlsUI then return end
    local leftObj = controlsUI:FindFirstChild("Left")
    local rightObj = controlsUI:FindFirstChild("Right")
    
    local touches = UserInputService:GetTouches()
    local leftActive, rightActive = false, false
    
    for _, touch in pairs(touches) do
        local function isTouching(obj)
            if not obj then return false end
            local pos = touch.Position
            local lp = obj.AbsolutePosition
            local sz = obj.AbsoluteSize
            return (pos.X >= lp.X and pos.X <= lp.X + sz.X and pos.Y >= lp.Y and pos.Y <= lp.Y + sz.Y)
        end
        if isTouching(leftObj) then leftActive = true end
        if isTouching(rightObj) then rightActive = true end
    end
    isTouchSteeringLeft = leftActive
    isTouchSteeringRight = rightActive
end)

RunService.RenderStepped:Connect(function()
    if not isFeaturesActive or not isFastSteer then return end
    local seat = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") and LocalPlayer.Character.Humanoid.SeatPart
    if seat and seat:IsA("VehicleSeat") then
        local targetSteer = 0
        if isTouchSteeringLeft then targetSteer = -1 elseif isTouchSteeringRight then targetSteer = 1 end
        
        if math.abs(targetSteer) > 0 then
            seat.Steer = targetSteer
        end
    end
end)
