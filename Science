RunService.Stepped:Connect(function(dt)
    if not isFeaturesActive then return end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart

    if seat and seat:IsA("VehicleSeat") then
        local steerInput = 0
        if isRightPressed then steerInput = 1 end
        if isLeftPressed then steerInput = -1 end
        
        if steerInput == 0 then
            steerInput = seat.SteerFloat
        end
        
        if steerInput ~= 0 then
            local speed = seat.AssemblyLinearVelocity.Magnitude
            local turnPower = -steerInput * 2.0
            
            if isBetterSteer then
                if speed > 20 then
                    turnPower = turnPower * math.clamp(45 / speed, 0.65, 1.0)
                end
            end
            
            local currentAngVel = seat.AssemblyAngularVelocity
            local targetY = turnPower
            
            if isFastSteer then
                targetY = currentAngVel.Y + (turnPower - currentAngVel.Y) * math.clamp(dt * 17, 0, 1)
            end
            
            seat.AssemblyAngularVelocity = Vector3.new(currentAngVel.X, targetY, currentAngVel.Z)
        end
    end
end)