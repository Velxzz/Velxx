-- Sistem Deteksi Klik Layar untuk Menangkap Tombol UI Game
UserInputService.InputBegan:Connect(function(input)
    if not settingTarget then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        local guiObjects = LocalPlayer.PlayerGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
        
        for _, gui in ipairs(guiObjects) do
            if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and gui ~= RightSetBtn and gui ~= LeftSetBtn and gui ~= SteerToggleBtn then
                if settingTarget == "Right" then
                    boundRightButton = gui
                    RightSetBtn.Text = "Saved!"
                    RightSetBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                elseif settingTarget == "Left" then
                    boundLeftButton = gui
                    LeftSetBtn.Text = "Saved!"
                    LeftSetBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                end
                settingTarget = nil
                break
            end
        end
    end
end)

-- Memantau Status Sentuhan pada Tombol Kanan/Kiri yang sudah di-bind
RunService.Heartbeat:Connect(function()
    if not isBetterSteer then return end
    
    currentSteerDirection = 0
    
    -- Cek status tombol Kanan
    if boundRightButton and boundRightButton.Parent then
        -- Asumsi tombol aktif jika transparasinya rendah atau sedang disentuh
        if boundRightButton.BackgroundTransparency < 0.8 then
            -- Kamu juga bisa kustomisasi deteksi tambahan jika dibutuhkan
        end
    end
    
    -- Simulasi tarikan fisik berdasarkan input
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and currentSteerDirection ~= 0 then
        local force = root.CFrame.RightVector * (currentSteerDirection * 25)
        root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + force
    end
end)
