-- LOGIKA TERBARU DENGAN PENCARIAN PRESISI BERBASIS USERNAME CAR MODEL
RunService.Stepped:Connect(function()
    if not isFeaturesActive then return end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart

    if seat and seat:IsA("VehicleSeat") then
        local vel = seat.AssemblyLinearVelocity
        
        if vel.Y > 8 or vel.Y < -15 then
            seat.AssemblyLinearVelocity = Vector3.new(vel.X, math.clamp(vel.Y, -10, 5), vel.Z)
        end

        -- Cari Model kendaraan pemain berdasarkan pola nama [Username]Car
        local playerCarName = LocalPlayer.Name .. "Car"
        local carModel = workspace:FindFirstChild(playerCarName) or seat:FindFirstAncestor(playerCarName) or seat.Parent.Parent
        
        if carModel then
            CarLabel.Text = "Car: " .. carModel.Name
            local gyro = carModel:FindFirstChild("LeanGyro", true)
            
            if gyro then
                if activeBodyGyro ~= gyro then
                    activeBodyGyro = gyro
                    defaultP = gyro.P
                    defaultD = gyro.D
                    
                    -- Masukkan nilai bawaan game ke TextBox P & D
                    SteerBoxP.Text = tostring(defaultP)
                    SteerBoxD.Text = tostring(defaultD)
                end

                if isSteerSettingActive then
                    local targetP = tonumber(SteerBoxP.Text) or defaultP
                    local targetD = tonumber(SteerBoxD.Text) or defaultD

                    gyro.P = targetP
                    gyro.D = targetD
                end
            end
        end
    else
        activeBodyGyro = nil
        CarLabel.Text = "Car: None"
    end
end)