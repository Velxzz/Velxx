-- Perbaikan Logika Better Steer agar mendeteksi VehicleSeat ataupun Seat biasa dengan aman
RunService.Stepped:Connect(function()
    if not isFeaturesActive or not isBetterSteer then return end
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    
    if seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
        local vehicle = seat:FindFirstAncestorOfClass("Model") or seat.Parent
        local valuesFolder = vehicle and (vehicle:FindFirstChild("Values", true) or vehicle:FindFirstChild("Configuration", true))
        
        local rawSteer = 0
        if seat:IsA("VehicleSeat") then
            rawSteer = seat.SteerFloat
        end
        
        if valuesFolder then
            local steerT = valuesFolder:FindFirstChild("#SteerT") or valuesFolder:FindFirstChild("SteerT")
            local steerC = valuesFolder:FindFirstChild("#SteerC") or valuesFolder:FindFirstChild("SteerC")
            
            if rawSteer ~= 0 then
                if steerT then steerT.Value = rawSteer * 2.0 end
                if steerC then steerC.Value = rawSteer * 1.8 end
            end
        end
        
        -- Tambahan penanganan rotasi angular langsung jika stir motor/mobil tidak merespons folder
        if rawSteer ~= 0 then
            seat.AssemblyAngularVelocity = Vector3.new(0, rawSteer * 4.0, 0)
        end
    end
end)
