SmoothFloatBtn.MouseButton1Click:Connect(function()
    if not isFeaturesActive then return end
    isSmoothBoosting = not isSmoothBoosting
    SmoothFloatBtn.Text = isSmoothBoosting and "🔥" or "⚡"

    if isSmoothBoosting then
        task.spawn(function()
            while isSmoothBoosting and isFeaturesActive do
                local seat = getCurrentVehicle()

                if seat and seat:IsA("BasePart") then
                    local addPower = tonumber(SmoothBox1.Text) or 3.5
                    local delayVal = tonumber(SmoothBox2.Text) or 0.03
                    local curVel = seat.AssemblyLinearVelocity
                    seat.AssemblyLinearVelocity = (curVel + (seat.CFrame.LookVector * addPower)) + Vector3.new(0, math.clamp(curVel.Y, -5, 3), 0)
                    task.wait(delayVal)
                else
                    isSmoothBoosting = false
                    SmoothFloatBtn.Text = "⚡"
                    break
                end
            end
        end)
    end
end)

SmoothReverseFloatBtn.MouseButton1Click:Connect(function()
    if not isFeaturesActive then return end
    isSmoothReversing = not isSmoothReversing
    SmoothReverseFloatBtn.Text = isSmoothReversing and "💥" or "🛑"

    if isSmoothReversing then
        task.spawn(function()
            while isSmoothReversing and isFeaturesActive do
                local seat = getCurrentVehicle()

                if seat and seat:IsA("BasePart") then
                    local brakePower = tonumber(BrakeBox1.Text) or 4
                    local delayVal = tonumber(BrakeBox2.Text) or 0.0225

                    local currentVel = seat.AssemblyLinearVelocity
                    local forwardSpeed = currentVel:Dot(seat.CFrame.LookVector)

                    if forwardSpeed > 0 then
                        local newVel = currentVel - (seat.CFrame.LookVector * brakePower)
                        seat.AssemblyLinearVelocity = Vector3.new(newVel.X, math.clamp(newVel.Y, -5, 3), newVel.Z)
                    elseif forwardSpeed > -1 then
                        seat.AssemblyLinearVelocity = Vector3.new(0, math.clamp(currentVel.Y, -5, 3), 0)
                    end
                    task.wait(delayVal)
                else
                    isSmoothReversing = false
                    SmoothReverseFloatBtn.Text = "🛑"
                    break
                end
            end
        end)
    end
end)

