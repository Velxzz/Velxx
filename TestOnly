-- Services
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Safe UI Container
local parentContainer = gethui and gethui() or (CoreGui:FindFirstChild("CoreGui") or LocalPlayer:WaitForChild("PlayerGui"))

-- Clean up GUI lama jika ada
if parentContainer:FindFirstChild("CustomSpectateGui") then
    parentContainer.CustomSpectateGui:Destroy()
end

-- ScreenGui Utama
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CustomSpectateGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 999999
ScreenGui.Parent = parentContainer

-- 1. Tombol Mengambang (Float Shortcut) Berbentuk Mata Transparan di Tengah Atas (1/4 Atas)
local FloatEyeBtn = Instance.new("TextButton", ScreenGui)
FloatEyeBtn.Name = "Button"
FloatEyeBtn.Size = UDim2.new(0, 45, 0, 45)
FloatEyeBtn.Position = UDim2.new(0.5, -22, 0.25, -22)
FloatEyeBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
FloatEyeBtn.BackgroundTransparency = 0.4 -- Transparan
FloatEyeBtn.Text = "👁️"
FloatEyeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FloatEyeBtn.Font = Enum.Font.GothamBold
FloatEyeBtn.TextSize = 20
FloatEyeBtn.Active = true
FloatEyeBtn.Draggable = true
Instance.new("UICorner", FloatEyeBtn).CornerRadius = UDim.new(1, 0) -- Bentuk Bulat

-- 2. Main Control Bar (Bar Navigasi) di Tengah Bawah (3/4 Bawah / Nyaris Tengah Bawah)
local Bar = Instance.new("Frame", ScreenGui)
Bar.Name = "Bar"
Bar.Size = UDim2.new(0, 200, 0, 45)
-- Posisi awal tersembunyi di luar layar / transparan, nanti di-tween kemari: UDim2.new(0.5, -100, 0.75, 0)
Bar.Position = UDim2.new(0.5, -100, 1.2, 0) 
Bar.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
Bar.BackgroundTransparency = 0.2
Bar.BorderSizePixel = 0
Instance.new("UICorner", Bar).CornerRadius = UDim.new(0, 8)

-- Judul / Nama Player yang sedang ditonton
local Title = Instance.new("TextLabel", Bar)
Title.Name = "Title"
Title.Size = UDim2.new(1, -70, 1, 0)
Title.Position = UDim2.new(0, 35, 0, 0)
Title.Text = LocalPlayer.Name
Title.TextColor3 = Color3.fromRGB(0, 170, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 11
Title.BackgroundTransparency = 1

-- Tombol Previous (<)
local PreviousBtn = Instance.new("TextButton", Bar)
PreviousBtn.Name = "Previous"
PreviousBtn.Size = UDim2.new(0, 30, 1, 0)
PreviousBtn.Position = UDim2.new(0, 0, 0, 0)
PreviousBtn.BackgroundTransparency = 1
PreviousBtn.Text = "<"
PreviousBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
PreviousBtn.Font = Enum.Font.GothamBold
PreviousBtn.TextSize = 14

-- Tombol Next (>)
local NextBtn = Instance.new("TextButton", Bar)
NextBtn.Name = "Next"
NextBtn.Size = UDim2.new(0, 30, 1, 0)
NextBtn.Position = UDim2.new(1, -30, 0, 0)
NextBtn.BackgroundTransparency = 1
NextBtn.Text = ">"
NextBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
NextBtn.Font = Enum.Font.GothamBold
NextBtn.TextSize = 14

-- Logika 100% dari Script Dex Asli
local cam = Workspace.CurrentCamera
local isSpectating = false

local function getPlayerIndex()
    for index, player in pairs(Players:GetPlayers()) do
        if player.Name == Title.Text then
            return index
        end
    end
    return 1
end

-- Tombol Mata (Toggle Spectate)
FloatEyeBtn.MouseButton1Click:Connect(function()
    if not isSpectating then
        isSpectating = true
        FloatEyeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 100) -- Berubah warna jadi hijau saat aktif
        Bar:TweenPosition(UDim2.new(0.5, -100, 0.75, 0), "In", "Linear", 0.5, true)
        pcall(function()
            Title.Text = Players:GetPlayerFromCharacter(cam.CameraSubject.Parent).Name
        end)
    else
        isSpectating = false
        FloatEyeBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 25) -- Kembali normal
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                cam.CameraSubject = LocalPlayer.Character.Humanoid
            end
        end)
        Bar:TweenPosition(UDim2.new(0.5, -100, 1.2, 0), "In", "Linear", 0.5, true)
    end
end)

-- Tombol Previous (<)
PreviousBtn.MouseButton1Click:Connect(function()
    task.wait(0.1)
    local allPlayers = Players:GetPlayers()
    local currentIndex = getPlayerIndex()
    if not pcall(function()
        cam.CameraSubject = allPlayers[currentIndex - 1].Character.Humanoid
    end) then
        cam.CameraSubject = allPlayers[#allPlayers].Character.Humanoid
    end
    pcall(function()
        Title.Text = Players:GetPlayerFromCharacter(cam.CameraSubject.Parent).Name
    end)
end)

-- Tombol Next (>)
NextBtn.MouseButton1Click:Connect(function()
    task.wait(0.1)
    local allPlayers = Players:GetPlayers()
    local currentIndex = getPlayerIndex()
    if not pcall(function()
        cam.CameraSubject = allPlayers[currentIndex + 1].Character.Humanoid
    end) then
        cam.CameraSubject = allPlayers[1].Character.Humanoid
    end
    pcall(function()
        Title.Text = Players:GetPlayerFromCharacter(cam.CameraSubject.Parent).Name
    end)
end)
