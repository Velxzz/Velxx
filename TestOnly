-- Fungsi Mengambil dan Menampilkan Kode Sumber dari URL/Loadstring
TargetBox.FocusLost:Connect(function(enterPressed)
    if not enterPressed then return end
    local input = TargetBox.Text
    if input == "" then return end
    
    StatusNote.Text = "Status: Mengambil data dari URL..."
    StatusNote.TextColor3 = Color3.fromRGB(255, 170, 0)
    
    -- Membersihkan input: jika user memasukkan format loadstring lengkap, ambil URL di dalamnya
    local targetURL = input
    if string.find(input, "game:HttpGet") then
        local extracted = string.match(input, "['%\"()(http[s]?://.-)['%\"()]'")
        if extracted then
            targetURL = extracted
        end
    end
    
    -- Eksekusi HttpGet untuk mendownload isi skrip
    local success, result = pcall(function()
        return game:HttpGet(targetURL)
    end)
    
    if success and result and result ~= "" then
        CodeViewer.Text = result
        StatusNote.Text = "Status: Berhasil memuat kode sumber!"
        StatusNote.TextColor3 = Color3.fromRGB(50, 200, 50)
    else
        CodeViewer.Text = "-- Gagal mengambil kode dari URL tersebut.\n-- Pastikan link URL benar atau dapat diakses publik (Raw GitHub)."
        StatusNote.Text = "Status: Gagal mengambil URL!"
        StatusNote.TextColor3 = Color3.fromRGB(220, 50, 50)
    end
end)
