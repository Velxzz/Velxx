-- ELEMEN RADAR UTAMA
local CenterArrow = Instance.new("ImageLabel")
CenterArrow.AnchorPoint = Vector2.new(0.5, 0.5)
CenterArrow.Position = UDim2.new(0.5, 0, 0.5, 0)
CenterArrow.BackgroundTransparency = 1
