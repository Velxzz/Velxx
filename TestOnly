local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Hapus GUI lama jika ada
if CoreGui:FindFirstChild("RadarGui") then
    CoreGui.RadarGui:Destroy()
end

-- Konfigurasi Radar
local radarSize = 120
local radarRadius = 60
local maxDistance = 200

-- Asset ID gambar kustom
local myArrowImage = "rbxassetid://136352049524226"   -- Gambar panah untuk Kita (di tengah)
local otherArrowImage = "rbxassetid://107576921395362" -- Gambar panah untuk Orang Lain

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RadarGui"
local success = pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not success then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local RadarFrame = Instance.new("Frame")
RadarFrame.Size = UDim2.new(0, radarSize, 0, radarSize)
RadarFrame.Position = UDim2.new(1, -140, 0, 20)
RadarFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
RadarFrame.BackgroundTransparency = 0.5
RadarFrame.BorderSizePixel = 2
RadarFrame.BorderColor3 = Color3.fromRGB(0, 255, 0)
RadarFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = RadarFrame

-- Titik tengah (Karakter kita menggunakan gambar kustom)
local CenterArrow = Instance.new("ImageLabel")
CenterArrow.Size = UDim2.new(0, 14, 0, 14)
CenterArrow.AnchorPoint = Vector2.new(0.5, 0.5)
CenterArrow.Position = UDim2.new(0.5, 0, 0.5, 0)
CenterArrow.BackgroundTransparency = 1
CenterArrow.Image = myArrowImage
CenterArrow.Parent = RadarFrame

local BlipsContainer = Instance.new("Folder")
BlipsContainer.Name = "Blips"
BlipsContainer.Parent = RadarFrame

local playerBlips = {}

RunService.RenderStepped:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local myHRP = character.HumanoidRootPart
    local myPos = myHRP.Position
    local myLookVector = myHRP.CFrame.LookVector
    
    local myAngle = math.atan2(myLookVector.X, myLookVector.Z)

    -- Rotasi gambar karakter kita di tengah mengikuti arah hadap kamera/karakter
    CenterArrow.Rotation = 0 -- Atau bisa disesuaikan jika ingin ikut berputar

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            activePlayers[player] = true
            local targetHRP = player.Character.HumanoidRootPart
            local targetPos = targetHRP.Position
            
            local offset = targetPos - myPos
            local distance = offset.Magnitude
            
            local blip = playerBlips[player]
            if not blip then
                -- Menggunakan gambar kustom untuk player lain
                blip = Instance.new("ImageLabel")
                blip.Size = UDim2.new(0, 14, 0, 14)
                blip.AnchorPoint = Vector2.new(0.5, 0.5)
                blip.BackgroundTransparency = 1
                blip.Image = otherArrowImage
                blip.Parent = BlipsContainer
                
                playerBlips[player] = blip
            end
            
            if distance <= maxDistance then
                blip.Visible = true
                
                local targetAngle = math.atan2(offset.X, offset.Z)
                local relativeAngle = targetAngle - myAngle
                
                local clampedDist = math.clamp(distance / maxDistance, 0, 1) * radarRadius
                
                local blipX = math.sin(relativeAngle) * clampedDist
                local blipY = -math.cos(relativeAngle) * clampedDist
                
                blip.Position = UDim2.new(0.5, blipX, 0.5, blipY)
                
                -- Rotasi gambar panah player lain mengikuti arah hadap mereka secara relatif
                local targetLook = targetHRP.CFrame.LookVector
                local targetHeading = math.atan2(targetLook.X, targetLook.Z)
                local relativeHeading = targetHeading - myAngle
                blip.Rotation = math.deg(relativeHeading)
            else
                blip.Visible = false
            end
        end
    end
    
    for player, blip in pairs(playerBlips) do
        if not activePlayers[player] then
            blip:Destroy()
            playerBlips[player] = nil
        end
    end
end)
