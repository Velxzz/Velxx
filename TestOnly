local function drawLine(parent, thickness, color)
    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.BackgroundColor3 = color or Color3.fromRGB(0, 255, 200)
    line.BorderSizePixel = 0
    line.Parent = parent
    return line
end

local function updateLine(line, p1, p2, thickness)
    local dist = (p2 - p1).Magnitude
    local angle = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
    line.Size = UDim2.new(0, dist, 0, thickness or 1)
    line.Position = UDim2.new(0, (p1.X + p2.X) / 2, 0, (p1.Y + p2.Y) / 2)
    line.Rotation = angle
end

local function createViewportClone(player)
    if viewportClones[player] then return viewportClones[player] end
    local char = player.Character
    if not char then return nil end
    char.Archivable = true
    local clone = char:Clone()
    char.Archivable = false
    for _, item in ipairs(clone:GetDescendants()) do
        if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("Animator") or item:IsA("Sound") then
            item:Destroy()
        end
    end
    clone.Parent = ViewportFolder
    viewportClones[player] = clone
    return clone
end

local function removeViewportClone(player)
    if viewportClones[player] then viewportClones[player]:Destroy() viewportClones[player] = nil end
end

RunService.RenderStepped:Connect(function()
    if _G.RadarData.outlineMode == "RGB" and _G.RadarData.radarEnabled then
        _G.RadarStroke.Color = Color3.fromHSV((tick() % 4) / 4, 1, 1)
    end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end

    ViewportCam.CFrame = camera.CFrame ViewportCam.FieldOfView = camera.FieldOfView

    local myHRP = character.HumanoidRootPart
    local myPos = myHRP.Position
    local camCF = camera.CFrame
    local camLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
    local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

    local centerPosPx = Vector2.new(_G.RadarData.radarSizeVal / 2, _G.RadarData.radarSizeVal / 2)

    if _G.RadarData.radarEnabled then
        CenterArrow.Size = UDim2.new(0, _G.RadarData.arrowSizeVal, 0, _G.RadarData.arrowSizeVal)
        CenterArrow.Position = UDim2.new(0, centerPosPx.X, 0, centerPosPx.Y)
        local myLook = Vector3.new(myHRP.CFrame.LookVector.X, 0, myHRP.CFrame.LookVector.Z).Unit
        CenterArrow.Rotation = math.deg(math.atan2(myLook:Dot(camRight), myLook:Dot(camLook)))
    end

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            activePlayers[player] = true
            local targetChar = player.Character
            local targetHRP = targetChar.HumanoidRootPart
            local offset = targetHRP.Position - myPos
            local distance = offset.Magnitude

            -- RADAR BLIP & RADAR LINE ESP
            if _G.RadarData.radarEnabled then
                local blip = playerBlips[player]
                if not blip then
                    blip = Instance.new("ImageLabel") blip.AnchorPoint = Vector2.new(0.5, 0.5) blip.BackgroundTransparency = 1
                    blip.Image = _G.RadarData.otherArrowImage blip.ZIndex = 2 blip.Parent = BlipsContainer
                    playerBlips[player] = blip
                end

                local rLine = radarLines[player]
                if not rLine then
                    rLine = drawLine(RadarFrame, _G.RadarData.radarLineThickness, Color3.fromRGB(0, 255, 200))
                    rLine.ZIndex = 1
                    radarLines[player] = rLine
                end

                blip.Size = UDim2.new(0, _G.RadarData.arrowSizeVal, 0, _G.RadarData.arrowSizeVal)
                local screenRel = Vector2.new(offset:Dot(camRight), -offset:Dot(camLook))
                local mappedDist = math.clamp(distance / _G.RadarData.maxDistanceVal, 0, 1) * _G.RadarData.radarRadiusVal
                
                if screenRel.Magnitude > 0 then screenRel = screenRel.Unit * mappedDist end
                local blipPosPx = centerPosPx + screenRel
                blip.Position = UDim2.new(0, blipPosPx.X, 0, blipPosPx.Y)
                
                local targetLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z).Unit
                blip.Rotation = math.deg(math.atan2(targetLook:Dot(camRight), targetLook:Dot(camLook)))
                blip.Visible = true

                if _G.RadarData.radarLineEnabled then
                    updateLine(rLine, centerPosPx, blipPosPx, _G.RadarData.radarLineThickness)
                    rLine.Visible = true
                else
                    rLine.Visible = false
                end
            else
                if playerBlips[player] then playerBlips[player].Visible = false end
                if radarLines[player] then radarLines[player].Visible = false end
            end

            -- ESP CACHE
            local esp = espCache[player]
            if not esp then
                esp = {}
                local box = Instance.new("Frame") box.BackgroundTransparency = 1 box.BorderSizePixel = 0 box.Parent = EspContainer
                local stroke = Instance.new("UIStroke") stroke.Thickness = 1.5 stroke.Color = Color3.fromRGB(255, 50, 50) stroke.Parent = box
                esp.Box2D = box
                esp.Line = drawLine(EspContainer)
                
                local nameLbl = Instance.new("TextLabel")
                nameLbl.BackgroundTransparency = 1 nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameLbl.TextSize = 12 nameLbl.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
                nameLbl.Parent = EspContainer
                esp.Name = nameLbl

                local hl = Instance.new("Highlight") hl.FillColor = Color3.fromRGB(255, 0, 0) hl.FillTransparency = 0.5 hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                esp.Highlight = hl

                espCache[player] = esp
            end

            -- ESP REAL 3D MODEL
            if _G.RadarData.espHologramEnabled then
                local clone = createViewportClone(player)
                if clone then
                    for _, realPart in ipairs(targetChar:GetChildren()) do
                        if realPart:IsA("BasePart") then
                            local clonePart = clone:FindFirstChild(realPart.Name)
                            if clonePart then clonePart.CFrame = realPart.CFrame end
                        end
                    end
                end
            else
                removeViewportClone(player)
            end

            -- ESP HIGHLIGHT
            if _G.RadarData.espHighlightEnabled then esp.Highlight.Parent = targetChar esp.Highlight.Enabled = true else esp.Highlight.Enabled = false end

            local screenPos, onScreen = camera:WorldToViewportPoint(targetHRP.Position)

            -- ESP NAME & BOX & LINE
            if onScreen then
                if _G.RadarData.espNameEnabled then
                    esp.Name.Text = player.DisplayName .. " [" .. math.floor(distance) .. "m]"
                    esp.Name.Position = UDim2.new(0, screenPos.X - 100, 0, screenPos.Y - 35)
                    esp.Name.Size = UDim2.new(0, 200, 0, 20)
                    esp.Name.Visible = true
                else esp.Name.Visible = false end

                if _G.RadarData.espLineEnabled then
                    local vp = camera.ViewportSize
                    updateLine(esp.Line, Vector2.new(vp.X / 2, vp.Y), Vector2.new(screenPos.X, screenPos.Y), 1.5)
                    esp.Line.Visible = true
                else esp.Line.Visible = false end

                if _G.RadarData.espBoxEnabled then
                    local head = targetChar:FindFirstChild("Head")
                    local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or screenPos
                    local legPos = camera:WorldToViewportPoint(targetHRP.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height * 0.65
                    esp.Box2D.Size = UDim2.new(0, width, 0, height)
                    esp.Box2D.Position = UDim2.new(0, screenPos.X - width/2, 0, headPos.Y)
                    esp.Box2D.Visible = true
                else esp.Box2D.Visible = false end
            else
                esp.Name.Visible = false
                esp.Line.Visible = false
                esp.Box2D.Visible = false
            end
        end
    end

    -- CLEANUP
    for p, b in pairs(playerBlips) do if not activePlayers[p] then b:Destroy() playerBlips[p] = nil end end
    for p, l in pairs(radarLines) do if not activePlayers[p] then l:Destroy() radarLines[p] = nil end end
    for p, e in pairs(espCache) do
        if not activePlayers[p] then
            if e.Box2D then e.Box2D:Destroy() end
            if e.Line then e.Line:Destroy() end
            if e.Name then e.Name:Destroy() end
            if e.Highlight then e.Highlight:Destroy() end
            espCache[p] = nil
        end
    end
    for p, _ in pairs(viewportClones) do if not activePlayers[p] then removeViewportClone(p) end end
end)