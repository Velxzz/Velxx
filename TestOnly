local function updateGrid()
    GridContainer:ClearAllChildren()
    local scaleFactor = _G.RadarData.radarSizeVal / (_G.RadarData.maxDistanceVal * 2)
    local center = _G.RadarData.radarSizeVal / 2
    for offsetStuds = -_G.RadarData.maxDistanceVal, _G.RadarData.maxDistanceVal, 10 do
        local posPx = center + (offsetStuds * scaleFactor)
        if posPx >= 0 and posPx <= _G.RadarData.radarSizeVal then
            local vLine = Instance.new("Frame") vLine.Size = UDim2.new(0, 1, 1, 0) vLine.Position = UDim2.new(0, posPx, 0, 0)
            vLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255) vLine.BackgroundTransparency = (offsetStuds == 0) and 0.5 or 0.88 vLine.BorderSizePixel = 0 vLine.Parent = GridContainer
            local hLine = Instance.new("Frame") hLine.Size = UDim2.new(1, 0, 0, 1) hLine.Position = UDim2.new(0, 0, 0, posPx)
            hLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255) hLine.BackgroundTransparency = (offsetStuds == 0) and 0.5 or 0.88 hLine.BorderSizePixel = 0 hLine.Parent = GridContainer
        end
    end
end
updateGrid()

