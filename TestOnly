-- ELEMEN RADAR
local CenterArrow = Instance.new("ImageLabel")
CenterArrow.AnchorPoint = Vector2.new(0.5, 0.5)
CenterArrow.Position = UDim2.new(0.5, 0, 0.5, 0)
CenterArrow.BackgroundTransparency = 1
CenterArrow.Image = myArrowImage
CenterArrow.ZIndex = 2
CenterArrow.Parent = RadarFrame

local BlipsContainer = Instance.new("Folder")
BlipsContainer.Name = "Blips"
BlipsContainer.Parent = RadarFrame

local playerBlips = {}

RunService.RenderStepped:Connect(function()
    -- Efek Outline RGB Aktif
    if outlineMode == "RGB" and radarEnabled then
        local hue = (tick() % 4) / 4
        RadarFrame.BorderColor3 = Color3.fromHSV(hue, 1, 1)
    end
    
    if not radarEnabled then return end
    
    CenterArrow.Size = UDim2.new(0, arrowSizeVal, 0, arrowSizeVal)

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local myPos = character.HumanoidRootPart.Position
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local camLookVector = camera.CFrame.LookVector
    local camAngle = math.atan2(camLookVector.X, camLookVector.Z)
    
    local myHRP = character.HumanoidRootPart
    local myHeading = math.atan2(myHRP.CFrame.LookVector.X, myHRP.CFrame.LookVector.Z)
    CenterArrow.Rotation = math.deg(myHeading - camAngle)

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            activePlayers[player] = true
            local targetHRP = player.Character.HumanoidRootPart
            local targetPos = targetHRP.Position
            
            local offset = targetPos - myPos
            local distance = offset.Magnitude
            
            local blip = playerBlips[player]
            if not blip then
                blip = Instance.new("ImageLabel")
                blip.AnchorPoint = Vector2.new(0.5, 0.5)
                blip.BackgroundTransparency = 1
                blip.Image = otherArrowImage
                blip.ZIndex = 1
                blip.Parent = BlipsContainer
                
                playerBlips[player] = blip
            end
            
            blip.Size = UDim2.new(0, arrowSizeVal, 0, arrowSizeVal)
            
            if distance <= maxDistanceVal then
                blip.Visible = true
                
                local targetAngle = math.atan2(offset.X, offset.Z)
                local relativeAngle = targetAngle - camAngle
                
                local clampedDist = math.clamp(distance / maxDistanceVal, 0, 1) * radarRadiusVal
                
                -- Perbaikan orientasi sumbu X (dibalik menggunakan tanda minus agar akurat kiri-kanannya)
                local blipX = -math.sin(relativeAngle) * clampedDist
                local blipY = -math.cos(relativeAngle) * clampedDist
                
                blip.Position = UDim2.new(0.5, blipX, 0.5, blipY)
                
                local targetHeading = math.atan2(targetHRP.CFrame.LookVector.X, targetHRP.CFrame.LookVector.Z)
                local relativeHeading = targetHeading - camAngle
                blip.Rotation = math.deg(relativeHeading)
            else
                blip.Visible = false
            end
        end
    end
    
    for player, blip in pairs(playerBlips) do
        if not activePlayers[player] then
            blip:Destroy()
            playerBlips[player] = nil
        end
    end
end)
