-- Logika Save Config
SaveConfigBtn.MouseButton1Click:Connect(function()
    if #spawnedBlocks == 0 then
        StatusLabel.Text = "Spawn blocks first!"
        return
    end
    
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local randomCode = "C_"
