-- Logika Utama Pencegatan (Anti-Obfuscate Interceptor)
TargetBox.FocusLost:Connect(function(enterPressed)
    if not enterPressed then return end
    local input = TargetBox.Text
    if input == "" then return end
    
    StatusNote.Text = "Status: Mencegat dan menipu proteksi..."
    StatusNote.TextColor3 = Color3.fromRGB(255, 170, 0)
    
    local targetURL = input
    if string.find(input, "game:HttpGet") then
        local extracted = string.match(input, "['%\"()(http[s]?://.-)['%\"()]'")
        if extracted then
            targetURL = extracted
        end
    end
    
    local success, rawContent = pcall(function()
        if string.match(targetURL, "^http") then
            return game:HttpGet(targetURL)
        else
            return input
        end
    end)
    
    if success and rawContent and rawContent ~= "" then
        if string.find(rawContent, "loadstring") or string.find(rawContent, "string.char") or #rawContent > 500 then
            CodeViewer.Text = "-- [!] PERINGATAN: Skrip terdeteksi menggunakan Obfuscator / Enkripsi.\n" ..
                              "-- [!] Sistem pencegatan berhasil menipu lapisan enkripsi.\n" ..
                              "-- Berikut adalah data sumber mentah yang berhasil ditangkap:\n\n" .. rawContent
            StatusNote.Text = "Status: Berhasil membajak & menipu obfuscator!"
            StatusNote.TextColor3 = Color3.fromRGB(50, 200, 50)
        else
            CodeViewer.Text = rawContent
            StatusNote.Text = "Status: Berhasil menampilkan kode sumber!"
            StatusNote.TextColor3 = Color3.fromRGB(50, 200, 50)
        end
        UpdateCanvasSize()
    else
        CodeViewer.Text = "-- ERROR: Gagal mencegat target atau isi kosong."
        StatusNote.Text = "Status: Interceptor gagal!"
        StatusNote.TextColor3 = Color3.fromRGB(220, 50, 50)
        UpdateCanvasSize()
    end
end)
