local spawnedBlocks = {}
local isRunning = false
local currentIndex = 1

local function createVisualBlock(pos)
    local block = Instance.new("Part")
    block.Size = Vector3.new(4, 10, 4)
    block.Position = pos
    block.Anchored = true
    block.CanCollide = false
    block.Transparency = 0.5
    block.Material = Enum.Material.SmoothPlastic
    block.Color = Color3.fromRGB(255, 255, 255)
    
    local texture = Instance.new("Texture")
    texture.Face = Enum.NormalId.Top
    texture.Texture = "rbxassetid://620583021"
    texture.Parent = block
    
    block.Parent = workspace
    table.insert(spawnedBlocks, block)
end

local function spawnBlockAtPlayer()
    local char = LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local targetPart = (humanoid and humanoid.SeatPart) or rootPart
    
    if targetPart then
        local pos = targetPart.Position
        createVisualBlock(pos)
    end
end

SpawnBtn.MouseButton1Click:Connect(function()
    spawnBlockAtPlayer()
end)

StartBtn.MouseButton1Click:Connect(function()
    if #spawnedBlocks == 0 then return end
    isRunning = not isRunning
    StartBtn.Text = isRunning and "Pause" or "Start"
    currentIndex = 1
end)

ResetBtn.MouseButton1Click:Connect(function()
    isRunning = false
    StartBtn.Text = "Start"
    currentIndex = 1
    for _, block in ipairs(spawnedBlocks) do
        if block then block:Destroy() end
    end
    spawnedBlocks = {}
    StatusLabel.Text = "Reseted!"
end)

SaveConfigBtn.MouseButton1Click:Connect(function()
    if #spawnedBlocks == 0 then
        StatusLabel.Text = "Spawn blocks first!"
        return
    end
    
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local randomCode = "C_"
    math.randomseed(tick())
    for i = 1, 13 do
        local randIndex = math.random(1, #chars)
        randomCode = randomCode .. chars:sub(randIndex, randIndex)
    end
    
    local dataToSave = {}
    for _, block in ipairs(spawnedBlocks) do
        local p = block.Position
        table.insert(dataToSave, {p.X, p.Y, p.Z})
    end
    
    if writefile then
        local encodedData = game:GetService("HttpService"):JSONEncode(dataToSave)
        writefile("ModifierConfigs/" .. randomCode .. ".json", encodedData)
    end
    
    if setclipboard then
        setclipboard(randomCode)
        StatusLabel.Text = "Saved & Copied!"
    else
        StatusLabel.Text = "Saved Code: " .. randomCode
    end
end)

LoadConfigBtn.MouseButton1Click:Connect(function()
    local codeToLoad = LoadBox.Text:gsub("%s+", "")
    if codeToLoad == "" then
        StatusLabel.Text = "Enter code first!"
        return
    end
    
    local fileName = "ModifierConfigs/" .. codeToLoad .. ".json"
    if readfile and pcall(readfile, fileName) then
        for _, block in ipairs(spawnedBlocks) do
            if block then block:Destroy() end
        end
        spawnedBlocks = {}
        isRunning = false
        StartBtn.Text = "Start"
        
        local rawData = readfile(fileName)
        local decodedData = game:GetService("HttpService"):JSONDecode(rawData)
        
        for _, posData in ipairs(decodedData) do
            local pos = Vector3.new(posData[1], posData[2], posData[3])
            createVisualBlock(pos)
        end
        
        StatusLabel.Text = "Loaded Successfully!"
    else
        StatusLabel.Text = "Code not found!"
    end
end)

