local function drawLine(parent)
    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.BackgroundColor3 = Color3.fromRGB(0, 255, 200)
    line.BorderSizePixel = 0
    line.Parent = parent
    return line
end

local function updateLine(line, p1, p2)
    local dist = (p2 - p1).Magnitude
    local angle = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
    line.Size = UDim2.new(0, dist, 0, 1.5)
    line.Position = UDim2.new(0, (p1.X + p2.X) / 2, 0, (p1.Y + p2.Y) / 2)
    line.Rotation = angle
end

RunService.RenderStepped:Connect(function()
    if _G.RadarData.outlineMode == "RGB" and _G.RadarData.radarEnabled then
        _G.RadarStroke.Color = Color3.fromHSV((tick() % 4) / 4, 1, 1)
    end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local myHRP = character.HumanoidRootPart
    local myPos = myHRP.Position
    local camCF = camera.CFrame
    local camLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
    local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

    if _G.RadarData.radarEnabled then
        CenterArrow.Size = UDim2.new(0, _G.RadarData.arrowSizeVal, 0, _G.RadarData.arrowSizeVal)
        local myLook = Vector3.new(myHRP.CFrame.LookVector.X, 0, myHRP.CFrame.LookVector.Z).Unit
        CenterArrow.Rotation = math.deg(math.atan2(myLook:Dot(camRight), myLook:Dot(camLook)))
    end

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            activePlayers[player] = true
            local targetChar = player.Character
            local targetHRP = targetChar.HumanoidRootPart
            local offset = targetHRP.Position - myPos
            local distance = offset.Magnitude

            -- RADAR BLIP
            if _G.RadarData.radarEnabled then
                local blip = playerBlips[player]
                if not blip then
                    blip = Instance.new("ImageLabel") blip.AnchorPoint = Vector2.new(0.5, 0.5) blip.BackgroundTransparency = 1
                    blip.Image = _G.RadarData.otherArrowImage blip.ZIndex = 1 blip.Parent = BlipsContainer
                    playerBlips[player] = blip
                end
                blip.Size = UDim2.new(0, _G.RadarData.arrowSizeVal, 0, _G.RadarData.arrowSizeVal)
                if distance <= _G.RadarData.maxDistanceVal then
                    blip.Visible = true
                    local screenRel = Vector2.new(offset:Dot(camRight), -offset:Dot(camLook))
                    if screenRel.Magnitude > 0 then screenRel = screenRel.Unit * (math.clamp(distance / _G.RadarData.maxDistanceVal, 0, 1) * _G.RadarData.radarRadiusVal) end
                    blip.Position = UDim2.new(0.5, screenRel.X, 0.5, screenRel.Y)
                    local targetLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z).Unit
                    blip.Rotation = math.deg(math.atan2(targetLook:Dot(camRight), targetLook:Dot(camLook)))
                else blip.Visible = false end
            elseif playerBlips[player] then playerBlips[player].Visible = false end

            -- ESP CACHE
            local esp = espCache[player]
            if not esp then
                esp = {}
                -- Box 2D
                local box = Instance.new("Frame") box.BackgroundTransparency = 1 box.BorderSizePixel = 0 box.Parent = EspContainer
                local stroke = Instance.new("UIStroke") stroke.Thickness = 1.5 stroke.Color = Color3.fromRGB(255, 50, 50) stroke.Parent = box
                esp.Box2D = box

                -- Line
                esp.Line = drawLine(EspContainer)

                -- Highlight (Standard)
                local hl = Instance.new("Highlight") hl.FillColor = Color3.fromRGB(255, 0, 0) hl.FillTransparency = 0.5 hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                esp.Highlight = hl

                -- Highlight X-RAY (Chams AlwaysOnTop)
                local xray = Instance.new("Highlight")
                xray.Name = "XRayChams"
                xray.FillColor = Color3.fromRGB(0, 200, 255)
                xray.FillTransparency = 0.2
                xray.OutlineColor = Color3.fromRGB(255, 255, 255)
                xray.OutlineTransparency = 0
                xray.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Tembus Tembok!
                esp.XRay = xray

                espCache[player] = esp
            end

            -- ESP X-RAY CHAMS (TEMBUS TEMBOK MANIFESTASI REAL MODEL)
            if _G.RadarData.espHologramEnabled then
                esp.XRay.Parent = targetChar
                esp.XRay.Enabled = true
            else
                esp.XRay.Enabled = false
            end

            -- ESP HIGHLIGHT STANDARD
            if _G.RadarData.espHighlightEnabled then esp.Highlight.Parent = targetChar esp.Highlight.Enabled = true else esp.Highlight.Enabled = false end

            local screenPos, onScreen = camera:WorldToViewportPoint(targetHRP.Position)

            -- ESP LINE
            if _G.RadarData.espLineEnabled and onScreen then
                local vp = camera.ViewportSize
                updateLine(esp.Line, Vector2.new(vp.X / 2, vp.Y), Vector2.new(screenPos.X, screenPos.Y))
                esp.Line.Visible = true
            else
                esp.Line.Visible = false
            end

            -- ESP BOX 2D
            if _G.RadarData.espBoxEnabled and onScreen then
                local head = targetChar:FindFirstChild("Head")
                local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or screenPos
                local legPos = camera:WorldToViewportPoint(targetHRP.Position - Vector3.new(0, 3, 0))
                
                local height = math.abs(headPos.Y - legPos.Y)
                local width = height * 0.65
                
                esp.Box2D.Size = UDim2.new(0, width, 0, height)
                esp.Box2D.Position = UDim2.new(0, screenPos.X - width/2, 0, headPos.Y)
                esp.Box2D.Visible = true
            else
                esp.Box2D.Visible = false
            end
        end
    end

    -- CLEANUP
    for p, b in pairs(playerBlips) do if not activePlayers[p] then b:Destroy() playerBlips[p] = nil end end
    for p, e in pairs(espCache) do
        if not activePlayers[p] then
            if e.Box2D then e.Box2D:Destroy() end
            if e.Line then e.Line:Destroy() end
            if e.Highlight then e.Highlight:Destroy() end
            if e.XRay then e.XRay:Destroy() end
            espCache[p] = nil
        end
    end
end)
