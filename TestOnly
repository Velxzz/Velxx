-- GRID 10x10 STUDS
local GridContainer = Instance.new("Frame")
GridContainer.Size = UDim2.new(1, 0, 1, 0)
GridContainer.BackgroundTransparency = 1
GridContainer.ZIndex = 0
GridContainer.Parent = RadarFrame

local function updateGrid()
    GridContainer:ClearAllChildren()
    local scaleFactor = radarSizeVal / (maxDistanceVal * 2)
    local center = radarSizeVal / 2
    local gridStuds = 10
    
    for offsetStuds = -maxDistanceVal, maxDistanceVal, gridStuds do
        local posPx = center + (offsetStuds * scaleFactor)
        if posPx >= 0 and posPx <= radarSizeVal then
            local vLine = Instance.new("Frame")
            vLine.Size = UDim2.new(0, 1, 1, 0)
            vLine.Position = UDim2.new(0, posPx, 0, 0)
            vLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            vLine.BackgroundTransparency = (offsetStuds == 0) and 0.5 or 0.88
            vLine.BorderSizePixel = 0
            vLine.Parent = GridContainer
            
            local hLine = Instance.new("Frame")
            hLine.Size = UDim2.new(1, 0, 0, 1)
            hLine.Position = UDim2.new(0, 0, 0, posPx)
            hLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hLine.BackgroundTransparency = (offsetStuds == 0) and 0.5 or 0.88
            hLine.BorderSizePixel = 0
            hLine.Parent = GridContainer
        end
    end
end
updateGrid()

