local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Hapus GUI lama jika ada
if CoreGui:FindFirstChild("RadarGui") then
    CoreGui.RadarGui:Destroy()
end

-- Konfigurasi Radar
local radarSize = 120 -- Ukuran frame total
local radarRadius = 60 -- Radius jangkauan visual
local maxDistance = 200 -- Jangkauan maksimal dunia (studs)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RadarGui"
local success = pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not success then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local RadarFrame = Instance.new("Frame")
RadarFrame.Size = UDim2.new(0, radarSize, 0, radarSize)
RadarFrame.Position = UDim2.new(1, -140, 0, 20) -- Pojok kanan atas
RadarFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
RadarFrame.BackgroundTransparency = 0.5
RadarFrame.BorderSizePixel = 2
RadarFrame.BorderColor3 = Color3.fromRGB(0, 255, 0)
RadarFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = RadarFrame

-- Titik tengah (Karakter kita / Panah kecil di tengah)
local CenterDot = Instance.new("Frame")
CenterDot.Size = UDim2.new(0, 8, 0, 8)
CenterDot.Position = UDim2.new(0.5, -4, 0.5, -4)
CenterDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
CenterDot.Parent = RadarFrame

local CenterCorner = Instance.new("UICorner")
CenterCorner.CornerRadius = UDim.new(1, 0)
CenterCorner.Parent = CenterDot

local BlipsContainer = Instance.new("Folder")
BlipsContainer.Name = "Blips"
BlipsContainer.Parent = RadarFrame

local playerBlips = {}

RunService.RenderStepped:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local myHRP = character.HumanoidRootPart
    local myPos = myHRP.Position
    local myLookVector = myHRP.CFrame.LookVector
    
    -- Hitung sudut pandang kita di bidang XZ
    local myAngle = math.atan2(myLookVector.X, myLookVector.Z)

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            activePlayers[player] = true
            local targetHRP = player.Character.HumanoidRootPart
            local targetPos = targetHRP.Position
            
            local offset = targetPos - myPos
            local distance = offset.Magnitude
            
            local blip = playerBlips[player]
            if not blip then
                -- Menggunakan TextLabel atau Frame berbentuk segitiga/panah sederhana
                blip = Instance.new("TextLabel")
                blip.Size = UDim2.new(0, 12, 0, 12)
                blip.AnchorPoint = Vector2.new(0.5, 0.5)
                blip.BackgroundTransparency = 1
                blip.Text = "▲" -- Simbol panah
                blip.TextSize = 12
                blip.TextColor3 = Color3.fromRGB(0, 255, 0)
                blip.Parent = BlipsContainer
                
                playerBlips[player] = blip
            end
            
            if distance <= maxDistance then
                blip.Visible = true
                
                -- Hitung sudut relatif target terhadap arah hadap kita
                local targetAngle = math.atan2(offset.X, offset.Z)
                local relativeAngle = targetAngle - myAngle
                
                -- Skalakan jarak ke radius radar
                local clampedDist = math.clamp(distance / maxDistance, 0, 1) * radarRadius
                
                -- Koreksi orientasi (supaya depan di atas: sin untuk X, -cos untuk Y)
                local blipX = math.sin(relativeAngle) * clampedDist
                local blipY = -math.cos(relativeAngle) * clampedDist
                
                blip.Position = UDim2.new(0.5, blipX, 0.5, blipY)
                
                -- Rotasi panah mengikuti arah hadap player lain secara relatif
                local targetLook = targetHRP.CFrame.LookVector
                local targetHeading = math.atan2(targetLook.X, targetLook.Z)
                local relativeHeading = targetHeading - myAngle
                blip.Rotation = math.deg(relativeHeading)
            else
                blip.Visible = false
            end
        end
    end
    
    -- Hapus blip jika player keluar
    for player, blip in pairs(playerBlips) do
        if not activePlayers[player] then
            blip:Destroy()
            playerBlips[player] = nil
        end
    end
end)
