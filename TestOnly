-- Fungsi Otomatis Update CanvasSize Berdasarkan Panjang & Lebar Teks
local function UpdateCanvasSize()
    local textBounds = CodeViewer.TextBounds
    -- Menambahkan padding ekstra agar tidak mentok di pinggir
    CodeViewer.Size = UDim2.new(0, math.max(textBounds.X + 50, CodeScroll.AbsoluteSize.X), 0, math.max(textBounds.Y + 50, CodeScroll.AbsoluteSize.Y))
    CodeScroll.CanvasSize = UDim2.new(0, textBounds.X + 50, 0, textBounds.Y + 50)
end

CodeViewer:GetPropertyChangedSignal("Text"):Connect(UpdateCanvasSize)

