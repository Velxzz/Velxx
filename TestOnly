ValueBox.Text = "1"
ValueBox.Font = Enum.Font.GothamBold
ValueBox.TextSize = 14
Instance.new("UICorner", ValueBox).CornerRadius = UDim.new(0, 6)

local SpawnObjBtn = Instance.new("TextButton", MainFrame)
SpawnObjBtn.Size = UDim2.new(0, 100, 0, 50)
SpawnObjBtn.Position = UDim2.new(0, 15, 0, 95)
SpawnObjBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
SpawnObjBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
SpawnObjBtn.Text = "Spawn Modifier"
