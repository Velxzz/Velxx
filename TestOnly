-- Logika Mengubah Data Game secara Real-Time
ModifyBtn.MouseButton1Click:Connect(function()
    local path = PathBox.Text
    local prop = PropBox.Text
    local val = ValBox.Text
    
    local success, err = pcall(function()
        -- Evaluasi path objek
        local env = {game = game, workspace = workspace}
        local fn = loadstring("return " .. path)
        setfenv(fn, env)
        local targetObj = fn()
        
        if targetObj then
            -- Konversi tipe data otomatis (angka, boolean, atau teks)
            local finalVal = val
            if val == "true" then finalVal = true
            elseif val == "false" then finalVal = false
            elseif tonumber(val) ~= nil then finalVal = tonumber(val) end
            
            -- Ubah properti objek game
            targetObj[prop] = finalVal
            InfoLabel.Text = "Sukses! " .. path .. "." .. prop .. " diubah jadi: " .. tostring(finalVal)
            InfoLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            InfoLabel.Text = "Error: Objek tidak ditemukan di path tersebut."
            InfoLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    end)
    
    if not success then
        InfoLabel.Text = "Gagal Modifikasi: " .. tostring(err)
        InfoLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)
