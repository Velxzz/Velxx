local function createVisualBlock(cf)
    local block = Instance.new("Part")
    block.Size = Vector3.new(1, 1, 10)
    block.CFrame = cf
    block.Anchored = true
    block.CanCollide = false
    block.Transparency = 0.5
    block.Material = Enum.Material.SmoothPlastic
    block.Color = Color3.fromRGB(255, 255, 255)
    
    local texture = Instance.new("Texture")
    texture.Face = Enum.NormalId.Top
    texture.Texture = "rbxassetid://620583021"
    texture.Parent = block
    
    block.Parent = workspace
    table.insert(spawnedBlocks, block)
end

local function spawnBlockAtPlayer()
    local char = LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local targetPart = (humanoid and humanoid.SeatPart) or rootPart
    
    if targetPart then
        local currentPos = targetPart.Position
        local lookVector
        
        if lastPos then
            local moveDir = currentPos - lastPos
            if moveDir.Magnitude > 0.01 then
                lookVector = moveDir.Unit
            else
                lookVector = targetPart.CFrame.LookVector
            end
        else
            lookVector = targetPart.CFrame.LookVector
        end
        
        lastPos = currentPos
        
        local finalCFrame = CFrame.lookAt(currentPos, currentPos + Vector3.new(lookVector.X, 0, lookVector.Z), Vector3.new(0, 1, 0))
        createVisualBlock(finalCFrame)
    end
end

