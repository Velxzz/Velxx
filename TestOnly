-- LocalScript (Taruh di StarterPlayer > StarterPlayerScripts)
local Players = game:GetService("Players")
local RunService =GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Konfigurasi Radar
local radarRadius = 80 -- Ukuran radius radar di layar (dalam piksel)
local maxDistance = 200 -- Jarak maksimal dunia (studs) yang bisa dideteksi radar

-- Membuat GUI secara otomatis
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RadarGui"
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local RadarFrame = Instance.new("Frame")
RadarFrame.Size = UDim2.new(0, 160, 0, 160)
RadarFrame.Position = UDim2.new(0, 20, 1, -180) -- Posisi di pojok kiri bawah
RadarFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
RadarFrame.BackgroundTransparency = 0.5
RadarFrame.BorderSizePixel = 2
RadarFrame.BorderColor3 = Color3.fromRGB(0, 255, 0)
RadarFrame.Parent = ScreenGui

-- Bentuk lingkaran untuk radar
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = RadarFrame

-- Titik tengah (Karakter kita)
local CenterDot = Instance.new("Frame")
CenterDot.Size = UDim2.new(0, 6, 0, 6)
CenterDot.Position = UDim2.new(0.5, -3, 0.5, -3)
CenterDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
CenterDot.Parent = RadarFrame

local CenterCorner = Instance.new("UICorner")
CenterCorner.CornerRadius = UDim.new(1, 0)
CenterCorner.Parent = CenterDot

-- Garis Radar yang berputar
local Sweeper = Instance.new("Frame")
Sweeper.Size = UDim2.new(0, radarRadius, 0, 2)
Sweeper.Position = UDim2.new(0.5, 0, 0.5, 0)
Sweeper.AnchorPoint = Vector2.new(0, 0.5)
Sweeper.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
Sweeper.BackgroundTransparency = 0.5
Sweeper.Parent = RadarFrame

-- Folder penampung titik player lain
local BlipsContainer = Instance.new("Folder")
BlipsContainer.Name = "Blips"
BlipsContainer.Parent = RadarFrame

-- Tabel untuk menyimpan GUI titik pemain
local playerBlips = {}

RunService.RenderStepped:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local myPos = character.HumanoidRootPart.Position
    local myLookVector = character.HumanoidRootPart.CFrame.LookVector
    
    -- Memutar garis radar
    local sweepAngle = tick() * 3 -- Kecepatan putaran
    Sweeper.Rotation = math.deg(sweepAngle)

    -- Update posisi player lain
    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            activePlayers[player] = true
            local targetPos = player.Character.HumanoidRootPart.Position
            
            -- Hitung selisih posisi
            local offset = targetPos - myPos
            local distance = offset.Magnitude
            
            -- Ambil referensi titik (blip) atau buat baru jika belum ada
            local blip = playerBlips[player]
            if not blip then
                blip = Instance.new("Frame")
                blip.Size = UDim2.new(0, 6, 0, 6)
                blip.AnchorPoint = Vector2.new(0.5, 0.5)
                blip.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Titik hijau
                blip.Parent = BlipsContainer
                
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(1, 0)
                corner.Parent = blip
                
                playerBlips[player] = blip
            end
            
            if distance <= maxDistance then
                blip.Visible = true
                
                -- Hitung rotasi relatif terhadap arah pandang kamera/karakter kita
                local angle = math.atan2(offset.X, offset.Z) - math.atan2(myLookVector.X, myLookVector.Z)
                
                -- Skalakan jarak ke dalam radius radar GUI
                local clampedDist = math.clamp(distance / maxDistance, 0, 1) * radarRadius
                
                -- Hitung posisi X dan Y di dalam lingkaran radar
                local blipX = math.sin(angle) * clampedDist
                local blipY = math.cos(angle) * clampedDist
                
                blip.Position = UDim2.new(0.5, blipX, 0.5, blipY)
            else
                blip.Visible = false
            end
        end
    end
    
    -- Hapus titik pemain yang keluar game
    for player, blip in pairs(playerBlips) do
        if not activePlayers[player] then
            blip:Destroy()
            playerBlips[player] = nil
        end
    end
end)
