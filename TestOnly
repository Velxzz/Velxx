RunService.RenderStepped:Connect(function()
    if not isRunning or #spawnedBlocks == 0 then return end
    
    local speedVal = tonumber(SpeedBox.Text) or 0
    if speedVal <= 0 then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local targetPart = (humanoid and humanoid.SeatPart) or rootPart
    
    if targetPart then
        local targetBlock = spawnedBlocks[currentIndex]
        if targetBlock then
            local targetCFrame = targetBlock.CFrame
            local distance = (targetPart.Position - targetCFrame.Position).Magnitude
            
            if distance < 3 then
                currentIndex = currentIndex + 1
                if currentIndex > #spawnedBlocks then
                    currentIndex = 1
                    targetPart.CFrame = spawnedBlocks[1].CFrame
                end
            else
                targetPart.CFrame = targetPart.CFrame:Lerp(targetCFrame, math.clamp(speedVal * 0.1, 0.01, 1))
            end
        end
    end
end)
