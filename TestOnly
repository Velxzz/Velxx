local function createToggle(name, yPos, defaultText, callback)
    local lbl = Instance.new("TextLabel") lbl.Size = UDim2.new(0, 130, 0, 26) lbl.Position = UDim2.new(0, 10, 0, yPos)
    lbl.BackgroundTransparency = 1 lbl.Text = name lbl.TextColor3 = Color3.fromRGB(220, 220, 220) lbl.TextXAlignment = Enum.TextXAlignment.Left lbl.TextSize = 12 lbl.Parent = ScrollFrame
    local btn = Instance.new("TextButton") btn.Size = UDim2.new(0, 95, 0, 24) btn.Position = UDim2.new(1, -110, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40) btn.TextColor3 = Color3.fromRGB(255, 255, 255) btn.Text = defaultText btn.TextSize = 12 btn.Parent = ScrollFrame
    local corner = Instance.new("UICorner") corner.CornerRadius = UDim.new(0, 5) corner.Parent = btn
    btn.MouseButton1Click:Connect(function() callback(btn) end)
end

local function createInput(name, yPos, defaultValue, callback)
    local lbl = Instance.new("TextLabel") lbl.Size = UDim2.new(0, 130, 0, 26) lbl.Position = UDim2.new(0, 10, 0, yPos)
    lbl.BackgroundTransparency = 1 lbl.Text = name lbl.TextColor3 = Color3.fromRGB(220, 220, 220) lbl.TextXAlignment = Enum.TextXAlignment.Left lbl.TextSize = 12 lbl.Parent = ScrollFrame
    local box = Instance.new("TextBox") box.Size = UDim2.new(0, 95, 0, 24) box.Position = UDim2.new(1, -110, 0, yPos)
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 30) box.TextColor3 = Color3.fromRGB(0, 255, 200) box.Text = tostring(defaultValue) box.TextSize = 12 box.Parent = ScrollFrame
    local corner = Instance.new("UICorner") corner.CornerRadius = UDim.new(0, 5) corner.Parent = box
    local stroke = Instance.new("UIStroke") stroke.Color = Color3.fromRGB(60, 60, 60) stroke.Parent = box
    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then callback(num) else box.Text = tostring(defaultValue) end
    end)
end

