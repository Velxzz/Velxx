Instance.new("UICorner", SpawnObjBtn).CornerRadius = UDim.new(0, 6)

local ResetBtn = Instance.new("TextButton", MainFrame)
ResetBtn.Size = UDim2.new(0, 110, 0, 50)
ResetBtn.Position = UDim2.new(0, 135, 0, 95)
ResetBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
ResetBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
ResetBtn.Text = "Reset"
ResetBtn.Font = Enum.Font.GothamBold
ResetBtn.TextSize = 14
Instance.new("UICorner", ResetBtn).CornerRadius = UDim.new(0, 6)

local spawnedParts = {}
local isRunning = false

OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = true
    OpenBtn.Visible = false
end)

CloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    OpenBtn.Visible = true
end)

ToggleSpawnBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    ToggleSpawnBtn.Text = isRunning and "Pause" or "Start"
end)

SpawnObjBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local part = Instance.new("Part")
    part.Size = Vector3.new(1.5, 6, 1.5)
    part.Position = root.Position + (root.CFrame.LookVector * 4) + Vector3.new(0, 3, 0)
    part.Anchored = true
    part.BrickColor = BrickColor.new("White")
    part.Material = Enum.Material.SmoothPlastic
    part.Parent = Workspace

    table.insert(spawnedParts, part)
end)

ResetBtn.MouseButton1Click:Connect(function()
    isRunning = false
    ToggleSpawnBtn.Text = "Start"
    for _, p in ipairs(spawnedParts) do
        if p and p.Parent then
            p:Destroy()
        end
    end
    spawnedParts = {}
end)

RunService.Heartbeat:Connect(function()
    if not isRunning then return end
    
    local speedValue = tonumber(ValueBox.Text) or 0
    if speedValue <= 0 or #spawnedParts == 0 then return end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local targetPart = hum and hum.SeatPart or (char and char:FindFirstChild("HumanoidRootPart"))

    if targetPart then
        local targetIndex = math.clamp(math.floor(tick() * speedValue) % #spawnedParts + 1, 1, #spawnedParts)
        local activeBlock = spawnedParts[targetIndex]
        
        if activeBlock and activeBlock.Parent then
            local direction = (activeBlock.Position - targetPart.Position)
            if targetPart:IsA("BasePart") then
                targetPart.AssemblyLinearVelocity = direction.Unit * math.min(direction.Magnitude * 10, 50)
            end
        end
    end
end)
