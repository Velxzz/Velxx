CenterArrow.ZIndex = 2
CenterArrow.Parent = RadarFrame

local BlipsContainer = Instance.new("Folder")
BlipsContainer.Name = "Blips"
BlipsContainer.Parent = RadarFrame

local playerBlips = {}
local espElements = {}

-- LOGIKA RENDER STEPPED (RADAR + ESP)
RunService.RenderStepped:Connect(function()
    -- Effect RGB
    if outlineMode == "RGB" and radarEnabled then
        local hue = (tick() % 4) / 4
        RadarStroke.Color = Color3.fromHSV(hue, 1, 1)
    end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local myHRP = character.HumanoidRootPart
    local myPos = myHRP.Position
    
    local camCF = camera.CFrame
    local camLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
    local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
    
    -- Radar Player Arrow Rotation
    if radarEnabled then
        CenterArrow.Size = UDim2.new(0, arrowSizeVal, 0, arrowSizeVal)
        local myLook = Vector3.new(myHRP.CFrame.LookVector.X, 0, myHRP.CFrame.LookVector.Z).Unit
        CenterArrow.Rotation = math.deg(math.atan2(myLook:Dot(camRight), myLook:Dot(camLook)))
    end

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            activePlayers[player] = true
            local targetChar = player.Character
            local targetHRP = targetChar.HumanoidRootPart
            local targetPos = targetHRP.Position
            local offset = targetPos - myPos
            local distance = offset.Magnitude
            
            -- 1. PROSES RADAR BLIP
            if radarEnabled then
                local blip = playerBlips[player]
                if not blip then
                    blip = Instance.new("ImageLabel")
                    blip.AnchorPoint = Vector2.new(0.5, 0.5)
                    blip.BackgroundTransparency = 1
                    blip.Image = otherArrowImage
                    blip.ZIndex = 1
                    blip.Parent = BlipsContainer
                    playerBlips[player] = blip
                end
                
                blip.Size = UDim2.new(0, arrowSizeVal, 0, arrowSizeVal)
                if distance <= maxDistanceVal then
                    blip.Visible = true
                    local screenRel = Vector2.new(offset:Dot(camRight), -offset:Dot(camLook))
                    if screenRel.Magnitude > 0 then
                        screenRel = screenRel.Unit * (math.clamp(distance / maxDistanceVal, 0, 1) * radarRadiusVal)
                    end
                    blip.Position = UDim2.new(0.5, screenRel.X, 0.5, screenRel.Y)
                    
                    local targetLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z).Unit
                    blip.Rotation = math.deg(math.atan2(targetLook:Dot(camRight), targetLook:Dot(camLook)))
                else
                    blip.Visible = false
                end
            elseif playerBlips[player] then
                playerBlips[player].Visible = false
            end
            
            -- 2. PROSES FITUR ESP (BOX, LINE, HIGHLIGHT)
            local esp = espElements[player]
            if not esp then
                esp = {}
                -- ESP Box
                local box = Instance.new("Frame")
                box.BackgroundTransparency = 1
                box.BorderSizePixel = 0
                box.Parent = EspContainer
                local boxStroke = Instance.new("UIStroke")
                boxStroke.Thickness = 1.5
                boxStroke.Color = Color3.fromRGB(255, 50, 50)
                boxStroke.Parent = box
                esp.Box = box
                
                -- ESP Line (Tracer)
                local line = Instance.new("Frame")
                line.AnchorPoint = Vector2.new(0.5, 0.5)
                line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                line.BorderSizePixel = 0
                line.Parent = EspContainer
                esp.Line = line
                
                -- ESP Highlight
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.OutlineTransparency = 0
                esp.Highlight = hl
                
                espElements[player] = esp
            end
            
            -- Update Highlight
            if espHighlightEnabled then
                esp.Highlight.Parent = targetChar
                esp.Highlight.Enabled = true
            else
                esp.Highlight.Enabled = false
            end
            
            -- Update Box & Line berdasarkan WorldToViewportPoint
            local screenPos, onScreen = camera:WorldToViewportPoint(targetPos)
            if onScreen then
                -- ESP Box
                if espBoxEnabled then
                    local headPos = camera:WorldToViewportPoint(targetPos + Vector3.new(0, 3, 0))
                    local legPos = camera:WorldToViewportPoint(targetPos - Vector3.new(0, 3.5, 0))
                    local boxHeight = math.abs(headPos.Y - legPos.Y)
                    local boxWidth = boxHeight * 0.65
                    
                    esp.Box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                    esp.Box.Position = UDim2.new(0, screenPos.X - (boxWidth / 2), 0, headPos.Y)
                    esp.Box.Visible = true
                else
                    esp.Box.Visible = false
                end
                
                -- ESP Line
                if espLineEnabled then
                    local viewportSize = camera.ViewportSize
                    local startPos = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                    local targetVec = Vector2.new(screenPos.X, screenPos.Y)
                    local distancePx = (targetVec - startPos).Magnitude
                    local angle = math.atan2(targetVec.Y - startPos.Y, targetVec.X - startPos.X)
                    
                    esp.Line.Size = UDim2.new(0, distancePx, 0, 1.5)
                    esp.Line.Position = UDim2.new(0, (startPos.X + targetVec.X) / 2, 0, (startPos.Y + targetVec.Y) / 2)
                    esp.Line.Rotation = math.deg(angle)
                    esp.Line.Visible = true
                else
                    esp.Line.Visible = false
                end
            else
                esp.Box.Visible = false
                esp.Line.Visible = false
            end
        end
    end
    
    -- Cleanup jika player keluar server
    for player, blip in pairs(playerBlips) do
        if not activePlayers[player] then
            blip:Destroy()
            playerBlips[player] = nil
        end
    end
    for player, esp in pairs(espElements) do
        if not activePlayers[player] then
            if esp.Box then esp.Box:Destroy() end
            if esp.Line then esp.Line:Destroy() end
            if esp.Highlight then esp.Highlight:Destroy() end
            espElements[player] = nil
        end
    end
end)
