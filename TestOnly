-- Fungsi Mendapatkan & Menampilkan Kode Sumber Target
TargetBox.FocusLost:Connect(function(enterPressed)
    if not enterPressed then return end
    local query = TargetBox.Text
    if query == "" then return end
    
    StatusNote.Text = "Status: Mencari objek..."
    StatusNote.TextColor3 = Color3.fromRGB(255, 170, 0)
    
    -- Mencoba mencari objek berdasarkan path string sederhana
    local success, targetObj = pcall(function()
        -- Eksekusi string aman pakai loadstring atau pencarian hierarki dasar
        local env = {game = game, workspace = workspace, script = script}
        local fn, err = loadstring("return " .. query)
        if fn then
            setfenv(fn, env)
            return fn()
        end
        return nil
    end)
    
    if success and targetObj then
        -- Cek apakah objek punya fungsi decompile (biasanya didukung executor tingkat lanjut)
        if decompile and (targetObj:IsA("LocalScript") or targetObj:IsA("ModuleScript")) then
            local sourceCode = decompile(targetObj)
            CodeViewer.Text = sourceCode
            StatusNote.Text = "Status: Berhasil decompile skrip!"
            StatusNote.TextColor3 = Color3.fromRGB(50, 200, 50)
        elseif targetObj:IsA("StringValue") then
            CodeViewer.Text = targetObj.Value
            StatusNote.Text = "Status: Berhasil memuat StringValue!"
            StatusNote.TextColor3 = Color3.fromRGB(50, 200, 50)
        else
            CodeViewer.Text = "-- Objek ditemukan, tapi bukan LocalScript/ModuleScript atau fungsi decompile tidak didukung executor ini.\n-- Nama Tipe: " .. targetObj.ClassName
            StatusNote.Text = "Status: Objek valid, tapi tidak bisa dibaca kodenya."
            StatusNote.TextColor3 = Color3.fromRGB(220, 150, 0)
        end
    else
        CodeViewer.Text = "-- ERROR: Objek atau Path tidak ditemukan di dalam game!\n-- Pastikan penulisan path benar (contoh: game.Players.LocalPlayer.PlayerScripts...)"
        StatusNote.Text = "Status: Target tidak ditemukan!"
        StatusNote.TextColor3 = Color3.fromRGB(220, 50, 50)
    end
end)
