RunService.Heartbeat:Connect(function(dt)
    if not isRunning or #spawnedBlocks == 0 then return end
    
    local speedVal = currentSpeed
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local targetPart = (humanoid and humanoid.SeatPart) or rootPart
    
    if targetPart then
        if targetPart:IsA("BasePart") then
            targetPart.AssemblyLinearVelocity = Vector3.zero
            targetPart.AssemblyAngularVelocity = Vector3.zero
        end
        
        local targetBlock = spawnedBlocks[currentIndex]
        if targetBlock then
            local targetCFrame = targetBlock.CFrame
            
            if speedVal == 0 then
                targetPart.CFrame = targetCFrame
                currentIndex = currentIndex + 1
                if currentIndex > #spawnedBlocks then
                    currentIndex = 1
                    targetPart.CFrame = spawnedBlocks[1].CFrame
                end
            else
                local distance = (targetPart.Position - targetCFrame.Position).Magnitude
                
                -- Sistem dinamis: Semakin jauh jarak, alpha semakin besar (bergerak lebih cepat mengejar). 
                -- Semakin dekat, alpha melambat secara proporsional. 
                -- Pada kecepatan 1, dengan skala ini menghasilkan durasi perpindahan sekitar 1 detik ketika posisi dekat.
                local baseSpeedFactor = speedVal * 0.05
                local dynamicMultiplier = math.clamp(distance * 0.3, 0.2, 3.0)
                local alpha = math.clamp(baseSpeedFactor * dynamicMultiplier, 0.005, 1)
                
                if distance < 1.0 then
                    currentIndex = currentIndex + 1
                    if currentIndex > #spawnedBorder and currentIndex > #spawnedBlocks then
                        currentIndex = 1
                    end
                    if currentIndex > #spawnedBlocks then
                        currentIndex = 1
                        targetPart.CFrame = spawnedBlocks[1].CFrame
                    end
                else
                    targetPart.CFrame = targetPart.CFrame:Lerp(targetCFrame, alpha)
                end
            end
        end
    end
end)
