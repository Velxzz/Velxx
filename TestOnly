local HologramFolder = Workspace:FindFirstChild("3DHologramFolder") or Instance.new("Folder", Workspace)
HologramFolder.Name = "3DHologramFolder"

local function create3DHologram(player)
    if hologramClones[player] then return hologramClones[player] end
    local char = player.Character
    if not char then return nil end
    
    char.Archivable = true
    local clone = char:Clone()
    char.Archivable = false
    
    for _, item in ipairs(clone:GetDescendants()) do
        if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("Animator") or item:IsA("Humanoid") then
            item:Destroy()
        elseif item:IsA("BasePart") then
            item.CanCollide = false
            item.Anchored = true
            item.CastShadow = false
            item.Material = Enum.Material.ForceField
            item.Color = Color3.fromRGB(0, 200, 255)
            item.Transparency = 0.35
        end
    end
    
    clone.Name = "Holo_" .. player.Name
    clone.Parent = HologramFolder
    hologramClones[player] = clone
    return clone
end

local function remove3DHologram(player)
    if hologramClones[player] then
        hologramClones[player]:Destroy()
        hologramClones[player] = nil
    end
end

-- PERHITUNGAN BOX PRESIF TANPA SHIFT/OFFSET
local function getAccurateBoundingBox(character, camera)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, 0, 0, 0, 0 end
    
    local cframe, size = character:GetBoundingBox()
    local extents = size / 2
    
    local corners = {
        cframe * Vector3.new(-extents.X,  extents.Y, -extents.Z),
        cframe * Vector3.new( extents.X,  extents.Y, -extents.Z),
        cframe * Vector3.new(-extents.X, -extents.Y, -extents.Z),
        cframe * Vector3.new( extents.X, -extents.Y, -extents.Z),
        cframe * Vector3.new(-extents.X,  extents.Y,  extents.Z),
        cframe * Vector3.new( extents.X,  extents.Y,  extents.Z),
        cframe * Vector3.new(-extents.X, -extents.Y,  extents.Z),
        cframe * Vector3.new( extents.X, -extents.Y,  extents.Z)
    }
    
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local anyOnScreen = false
    
    for _, corner in ipairs(corners) do
        local screenPos, onScreen = camera:WorldToViewportPoint(corner)
        if onScreen then anyOnScreen = true end
        minX = math.min(minX, screenPos.X)
        minY = math.min(minY, screenPos.Y)
        maxX = math.max(maxX, screenPos.X)
        maxY = math.max(maxY, screenPos.Y)
    end
    
    return anyOnScreen, minX, minY, (maxX - minX), (maxY - minY)
end

RunService.RenderStepped:Connect(function()
    if _G.RadarData.outlineMode == "RGB" and _G.RadarData.radarEnabled then
        _G.RadarStroke.Color = Color3.fromHSV((tick() % 4) / 4, 1, 1)
    end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local myHRP = character.HumanoidRootPart
    local myPos = myHRP.Position
    local camCF = camera.CFrame
    local camLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
    local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
    
    if _G.RadarData.radarEnabled then
        CenterArrow.Size = UDim2.new(0, _G.RadarData.arrowSizeVal, 0, _G.RadarData.arrowSizeVal)
        local myLook = Vector3.new(myHRP.CFrame.LookVector.X, 0, myHRP.CFrame.LookVector.Z).Unit
        CenterArrow.Rotation = math.deg(math.atan2(myLook:Dot(camRight), myLook:Dot(camLook)))
    end

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            activePlayers[player] = true
            local targetChar = player.Character
            local targetHRP = targetChar.HumanoidRootPart
            local targetHead = targetChar:FindFirstChild("Head") or targetHRP
            local offset = targetHRP.Position - myPos
            local distance = offset.Magnitude
            
            -- RADAR
            if _G.RadarData.radarEnabled then
                local blip = playerBlips[player]
                if not blip then
                    blip = Instance.new("ImageLabel") blip.AnchorPoint = Vector2.new(0.5, 0.5) blip.BackgroundTransparency = 1
                    blip.Image = _G.RadarData.otherArrowImage blip.ZIndex = 1 blip.Parent = BlipsContainer
                    playerBlips[player] = blip
                end
                blip.Size = UDim2.new(0, _G.RadarData.arrowSizeVal, 0, _G.RadarData.arrowSizeVal)
                if distance <= _G.RadarData.maxDistanceVal then
                    blip.Visible = true
                    local screenRel = Vector2.new(offset:Dot(camRight), -offset:Dot(camLook))
                    if screenRel.Magnitude > 0 then screenRel = screenRel.Unit * (math.clamp(distance / _G.RadarData.maxDistanceVal, 0, 1) * _G.RadarData.radarRadiusVal) end
                    blip.Position = UDim2.new(0.5, screenRel.X, 0.5, screenRel.Y)
                    local targetLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z).Unit
                    blip.Rotation = math.deg(math.atan2(targetLook:Dot(camRight), targetLook:Dot(camLook)))
                else blip.Visible = false end
            elseif playerBlips[player] then playerBlips[player].Visible = false end
            
            -- ESP CONTAINER CREATION
            local esp = espElements[player]
            if not esp then
                esp = {}
                local box = Instance.new("Frame") box.BackgroundTransparency = 1 box.BorderSizePixel = 0 box.Parent = _G.EspContainer
                local boxStroke = Instance.new("UIStroke") boxStroke.Thickness = 1.5 boxStroke.Color = Color3.fromRGB(255, 50, 50) boxStroke.Parent = box
                esp.Box = box
                
                local line = Instance.new("Frame") 
                line.AnchorPoint = Vector2.new(0.5, 0.5) 
                line.BackgroundColor3 = Color3.fromRGB(255, 255, 255) 
                line.BorderSizePixel = 0 
                line.Parent = _G.EspContainer
                esp.Line = line
                
                local hl = Instance.new("Highlight") hl.FillColor = Color3.fromRGB(255, 0, 0) hl.FillTransparency = 0.5 hl.OutlineColor = Color3.fromRGB(255, 255, 255) esp.Highlight = hl
                espElements[player] = esp
            end
            
            if _G.RadarData.espHighlightEnabled then esp.Highlight.Parent = targetChar esp.Highlight.Enabled = true else esp.Highlight.Enabled = false end
            
            -- REAL 3D HOLOGRAM
            if _G.RadarData.espHologramEnabled then
                local holoClone = create3DHologram(player)
                if holoClone then
                    for _, pPart in ipairs(targetChar:GetChildren()) do
                        if pPart:IsA("BasePart") then
                            local cPart = holoClone:FindFirstChild(pPart.Name)
                            if cPart then cPart.CFrame = pPart.CFrame end
                        end
                    end
                end
            else
                remove3DHologram(player)
            end
            
            -- ESP BOX PRESIF
            if _G.RadarData.espBoxEnabled then
                local onScreen, x, y, w, h = getAccurateBoundingBox(targetChar, camera)
                if onScreen then 
                    esp.Box.Size = UDim2.new(0, w, 0, h) 
                    esp.Box.Position = UDim2.new(0, x, 0, y) 
                    esp.Box.Visible = true 
                else 
                    esp.Box.Visible = false 
                end
            else 
                esp.Box.Visible = false 
            end
            
            -- ESP LINE PRESIF
            if _G.RadarData.espLineEnabled then
                local targetPos, onScreen = camera:WorldToViewportPoint(targetHRP.Position)
                if onScreen then
                    local vp = camera.ViewportSize
                    local startPos = Vector2.new(vp.X / 2, vp.Y)
                    local endPos = Vector2.new(targetPos.X, targetPos.Y)
                    
                    local distanceVector = endPos - startPos
                    local length = distanceVector.Magnitude
                    local angle = math.deg(math.atan2(distanceVector.Y, distanceVector.X))
                    
                    esp.Line.Size = UDim2.new(0, length, 0, 1.5)
                    esp.Line.Position = UDim2.new(0, (startPos.X + endPos.X) / 2, 0, (startPos.Y + endPos.Y) / 2)
                    esp.Line.Rotation = angle
                    esp.Line.Visible = true
                else 
                    esp.Line.Visible = false 
                end
            else 
                esp.Line.Visible = false 
            end
        end
    end
    
    -- CLEANUP MEMORI
    for p, b in pairs(playerBlips) do if not activePlayers[p] then b:Destroy() playerBlips[p] = nil end end
    for p, e in pairs(espElements) do
        if not activePlayers[p] then
            if e.Box then e.Box:Destroy() end if e.Line then e.Line:Destroy() end
            if e.Highlight then e.Highlight:Destroy() end
            espElements[p] = nil
        end
    end
    for p, _ in pairs(hologramClones) do
        if not activePlayers[p] then remove3DHologram(p) end
    end
end)
