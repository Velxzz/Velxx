SaveConfigBtn.MouseButton1Click:Connect(function()
    if #spawnedBlocks == 0 then
        StatusLabel.Text = "Spawn blocks first!"
        return
    end
    
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local randomCode = "C_"
    math.randomseed(tick())
    for i = 1, 13 do
        local randIndex = math.random(1, #chars)
        randomCode = randomCode .. chars:sub(randIndex, randIndex)
    end
    
    local dataToSave = {}
    for _, block in ipairs(spawnedBlocks) do
        local cf = block.CFrame
        local comps = {cf:GetComponents()}
        table.insert(dataToSave, comps)
    end
    
    if writefile then
        local encodedData = game:GetService("HttpService"):JSONEncode(dataToSave)
        writefile("ModifierConfigs/" .. randomCode .. ".json", encodedData)
    end
    
    if setclipboard then
        setclipboard(randomCode)
        StatusLabel.Text = "Saved & Copied!"
    else
        StatusLabel.Text = "Saved Code: " .. randomCode
    end
end)

LoadConfigBtn.MouseButton1Click:Connect(function()
    local codeToLoad = LoadBox.Text:gsub("%s+", "")
    if codeToLoad == "" then
        StatusLabel.Text = "Enter code first!"
    end
    
    local fileName = "ModifierConfigs/" .. codeToLoad .. ".json"
    if readfile and pcall(readfile, fileName) then
        for _, block in ipairs(spawnedBlocks) do
            if block then block:Destroy() end
        end
        spawnedBlocks = {}
        isRunning = false
        StartBtn.Text = "Start"
        lastPos = nil
        
        local rawData = readfile(fileName)
        local decodedData = game:GetService("HttpService"):JSONDecode(rawData)
        
        for _, comps in ipairs(decodedData) do
            local cf = CFrame.new(table.unpack(comps))
            createVisualBlock(cf)
        end
        
        StatusLabel.Text = "Loaded Successfully!"
    else
        StatusLabel.Text = "Code not found!"
    end
end)

