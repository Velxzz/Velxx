-- Logika Save Config
SaveConfigBtn.MouseButton1Click:Connect(function()
    if #spawnedBlocks == 0 then
        StatusLabel.Text = "Spawn blocks first!"
        return
    end
    
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local randomCode = "C_"
    math.randomseed(os.time() + math.floor(tick() * 1000))
    for i = 1, 13 do
        local randIndex = math.random(1, #chars)
        randomCode = randomCode .. chars:sub(randIndex, randIndex)
    end
    
    local dataToSave = {}
    for _, block in ipairs(spawnedBlocks) do
        local cf = block.CFrame
        table.insert(dataToSave, {cf:GetComponents()})
    end
    
    if writefile then
        local encodedData = HttpService:JSONEncode(dataToSave)
        pcall(function()
            writefile("ModifierConfigs/" .. randomCode .. ".json", encodedData)
        end)
    end
    
    if setclipboard then
        setclipboard(randomCode)
        StatusLabel.Text = "Saved & Copied!"
    else
        StatusLabel.Text = "Saved Code: " .. randomCode
    end
end)

-- Logika Load Config
LoadConfigBtn.MouseButton1Click:Connect(function()
    local codeToLoad = LoadBox.Text:gsub("%s+", "")
    if codeToLoad == "" then
        StatusLabel.Text = "Enter code first!"
        return
    end
    
    local fileName = "ModifierConfigs/" .. codeToLoad .. ".json"
    if readfile and pcall(readfile, fileName) then
        for _, block in ipairs(spawnedBlocks) do
            if block then block:Destroy() end
        end
        spawnedBlocks = {}
        isRunning = false
        StartToggleBtn.Text = "OFF"
        StartToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        if FloatStart then FloatStart.Text = "Start" end
        currentIndex = 1
        lastPos = nil
        startingCFrame = nil
        currentTransitionTime = 0
        
        local rawData = readfile(fileName)
        local success, decodedData = pcall(function()
            return HttpService:JSONDecode(rawData)
        end)
        
        if success and type(decodedData) == "table" then
            for _, comps in ipairs(decodedData) do
                local cf = CFrame.new(table.unpack(comps))
                createVisualBlock(cf)
            end
            
            if #spawnedBlocks > 0 then
                lastPos = spawnedBlocks[#spawnedBlocks].Position
            end
            StatusLabel.Text = "Loaded Successfully!"
        else
            StatusLabel.Text = "Invalid Config Format!"
        end
    else
        StatusLabel.Text = "Code not found!"
    end
end)

-- Helper Pemindahan Karakter/Motor (Mempertahankan Rotasi Bawaan)
local function moveEntityTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local seatPart = humanoid and humanoid.SeatPart
    local targetPos = targetCFrame.Position
    
    if seatPart then
        local vehicleModel = seatPart:FindFirstAncestorOfClass("Model")
        if vehicleModel then
            local currentCF = vehicleModel:GetPivot()
            local newCF = CFrame.new(targetPos) * (currentCF - currentCF.Position)
            
            for _, part in ipairs(vehicleModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
            vehicleModel:PivotTo(newCF)
            return
        end
    end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if rootPart then
        local currentCF = rootPart.CFrame
        local newCF = CFrame.new(targetPos) * (currentCF - currentCF.Position)
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        char:PivotTo(newCF)
    end
end

-- Loop Heartbeat Teleport
RunService.Heartbeat:Connect(function(dt)
    if not activeFeatures or not isRunning or #spawnedBlocks == 0 then return end
    
    local speedVal = getSpeedValue()
    local targetBlock = spawnedBlocks[currentIndex]
    
    if targetBlock then
        local targetCFrame = targetBlock.CFrame
        
        if speedVal == 0 then
            moveEntityTo(targetCFrame)
            currentIndex = currentIndex + 1
            if currentIndex > #spawnedBlocks then
                currentIndex = 1
            end
            startingCFrame = nil
        else
            local char = LocalPlayer.Character
            local root = char and (char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").SeatPart or char:FindFirstChild("HumanoidRootPart"))
            
            if not startingCFrame and root then
                startingCFrame = root.CFrame
                currentTransitionTime = 0
            end
            
            currentTransitionTime = currentTransitionTime + dt
            local alpha = math.clamp(currentTransitionTime / speedVal, 0, 1)
            
            if startingCFrame then
                local lerpedPos = startingCFrame.Position:Lerp(targetCFrame.Position, alpha)
                moveEntityTo(CFrame.new(lerpedPos))
            end
            
            if alpha >= 1 then
                currentIndex = currentIndex + 1
                if currentIndex > #spawnedBlocks then
                    currentIndex = 1
                end
                startingCFrame = nil
                currentTransitionTime = 0
            end
        end
    end
end)