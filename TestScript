local function catmullRomVector(p0, p1, p2, p3, t)
    local t2 = t * t
    local t3 = t2 * t
    return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
end
local function renderCurvedPath()
    for _, block in ipairs(curveVisualBlocks) do block:Destroy() end
    table.clear(curveVisualBlocks)
    table.clear(curveCFrames)
    if #pathCFrames < 2 then return end
    local resolution = 25
    local extCFrames = {}
    local pFirst = pathCFrames[1].Position - (pathCFrames[2].Position - pathCFrames[1].Position)
    table.insert(extCFrames, CFrame.new(pFirst) * pathCFrames[1].Rotation)
    for _, cf in ipairs(pathCFrames) do table.insert(extCFrames, cf) end
    local pLast = pathCFrames[#pathCFrames].Position + (pathCFrames[#pathCFrames].Position - pathCFrames[#pathCFrames-1].Position)
    table.insert(extCFrames, CFrame.new(pLast) * pathCFrames[#pathCFrames].Rotation)
    for i = 2, #extCFrames - 2 do
        local cf0, cf1, cf2, cf3 = extCFrames[i - 1], extCFrames[i], extCFrames[i + 1], extCFrames[i + 2]
        for step = 0, resolution - 1 do
            local t = step / resolution
            local pos = catmullRomVector(cf0.Position, cf1.Position, cf2.Position, cf3.Position, t)
            local rot = cf1.Rotation:Lerp(cf2.Rotation, t)
            local finalCF = CFrame.new(pos) * rot
            table.insert(curveCFrames, finalCF)
            local curveBlock = Instance.new("Part")
            curveBlock.Name = "Curve_Point"
            curveBlock.Size = Vector3.new(0.5, 0.5, 0.5)
            curveBlock.CFrame = finalCF
            curveBlock.Anchored = true
            curveBlock.CanCollide = false
            curveBlock.Material = Enum.Material.Neon
            curveBlock.Color = Color3.fromRGB(255, 170, 0)
            curveBlock.Transparency = showVisualParts and 0.4 or 1
            curveBlock.Parent = PathFolder
            table.insert(curveVisualBlocks, curveBlock)
        end
    end
end
local function addPathPointCFrame(cf)
    table.insert(pathCFrames, cf)
    local block = Instance.new("Part")
    block.Name = "Path_Node_1x1x1"
    block.Size = Vector3.new(1, 1, 1)
    block.CFrame = cf
    block.Anchored = true
    block.CanCollide = false
    block.Material = Enum.Material.Neon
    block.Color = Color3.fromRGB(255, 50, 50)
    block.Transparency = showVisualParts and 0.2 or 1
    block.Parent = PathFolder
    table.insert(pathVisualBlocks, block)
    renderCurvedPath()
end
