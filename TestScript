    stopMonitoring()
    if activeCCTV then activeCCTV:Destroy(); activeCCTV = nil end
    if centerPart then centerPart:Destroy(); centerPart = nil end
    PathFolder:ClearAllChildren()
    table.clear(pathPoints)
    table.clear(pathVisualBlocks)
    table.clear(curvePositions)
    table.clear(curveVisualBlocks)
