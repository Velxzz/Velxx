-- System Variables
local activeCCTV = nil
local isMonitoring = false
local isCamLocked = true
local zoomLevel = 1
local baseFOV = 70

local cameraRotX = 0
local cameraRotY = 0

-- Fungsi Toggle Muncul/Sembunyi Menu Utama
local function toggleMenuVisibility()
    MainFrame.Visible = not MainFrame.Visible
end

-- Hubungkan tombol Floating Shortcut supaya bisa diklik untuk buka/tutup menu
FloatBtn.MouseButton1Click:Connect(toggleMenuVisibility)

-- Function Stop Monitoring
local function stopMonitoring()
    isMonitoring = false
    ToggleViewBtn.Text = "VIEW CCTV: OFF"
    ToggleViewBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    
    CurrentCamera.CameraType = Enum.CameraType.Custom
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    end
    CurrentCamera.FieldOfView = baseFOV
end

local function updateZoomDisplay()
    ZoomLabel.Text = "Zoom: " .. zoomLevel .. "x"
end

-- Spawn CCTV
local function spawnCCTVAction()
    if activeCCTV then
        activeCCTV:Destroy()
        activeCCTV = nil
    end
    
    local camCFrame = CurrentCamera.CFrame
    
    local block = Instance.new("Part")
    block.Name = "CCTV_Block"
    block.Size = Vector3.new(1, 1, 1)
    block.CFrame = camCFrame
    block.Anchored = true
    block.CanCollide = false
    block.Material = Enum.Material.Neon
    block.Color = Color3.fromRGB(255, 0, 50)
    block.Transparency = 0.3
    block.Parent = Workspace
    
    activeCCTV = block
    
    local lookVector = camCFrame.LookVector
    cameraRotX = math.atan2(-lookVector.X, -lookVector.Z)
    cameraRotY = math.asin(math.clamp(lookVector.Y, -1, 1))
    
    if isMonitoring then
        CurrentCamera.CFrame = activeCCTV.CFrame
    end
end

SpawnBtn.MouseButton1Click:Connect(spawnCCTVAction)

-- Toggle View CCTV
local function toggleViewAction()
    if not activeCCTV then return end
    
    isMonitoring = not isMonitoring
    if isMonitoring then
        ToggleViewBtn.Text = "VIEW CCTV: ON"
        ToggleViewBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        CurrentCamera.CameraType = Enum.CameraType.Scriptable
        
        if activeCCTV then
            local lookVector = activeCCTV.CFrame.LookVector
            cameraRotX = math.atan2(-lookVector.X, -lookVector.Z)
            cameraRotY = math.asin(math.clamp(lookVector.Y, -1, 1))
            CurrentCamera.CFrame = activeCCTV.CFrame
        end
        
        updateZoomDisplay()
    else
        stopMonitoring()
    end
end

ToggleViewBtn.MouseButton1Click:Connect(toggleViewAction)

-- Toggle Camera Lock / Unlock
LockCamBtn.MouseButton1Click:Connect(function()
    isCamLocked = not isCamLocked
    if isCamLocked then
        LockCamBtn.Text = "CAMERA LOCK: LOCKED"
        LockCamBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        if activeCCTV and isMonitoring then
            CurrentCamera.CFrame = activeCCTV.CFrame
        end
    else
        LockCamBtn.Text = "CAMERA LOCK: UNLOCKED"
        LockCamBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 200)
        if activeCCTV then
            local lookVector = activeCCTV.CFrame.LookVector
            cameraRotX = math.atan2(-lookVector.X, -lookVector.Z)
            cameraRotY = math.asin(math.clamp(lookVector.Y, -1, 1))
        end
    end
end)

-- Zoom In (+)
ZoomInBtn.MouseButton1Click:Connect(function()
    if not isMonitoring then return end
    zoomLevel = math.min(5, zoomLevel + 1)
    updateZoomDisplay()
end)

-- Zoom Out (-)
ZoomOutBtn.MouseButton1Click:Connect(function()
    if not isMonitoring then return end
    zoomLevel = math.max(1, zoomLevel - 1)
    updateZoomDisplay()
end)

-- Reset CCTV
local function resetAction()
    stopMonitoring()
    if activeCCTV then
        activeCCTV:Destroy()
        activeCCTV = nil
    end
end

ResetBtn.MouseButton1Click:Connect(resetAction)

-- RenderStepped
RunService.RenderStepped:Connect(function()
    if isMonitoring and activeCCTV then
        if isCamLocked then
            CurrentCamera.CFrame = activeCCTV.CFrame
        else
            CurrentCamera.CFrame = CFrame.new(activeCCTV.Position) * CFrame.Angles(0, cameraRotX, 0) * CFrame.Angles(cameraRotY, 0, 0)
        end
        
        local targetFOV = baseFOV / zoomLevel
        if CurrentCamera.FieldOfView ~= targetFOV then
            CurrentCamera.FieldOfView = targetFOV
        end
    end
end)

-- Kontrol Geser Kamera dengan Mouse saat UNLOCKED
UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if isMonitoring and not isCamLocked and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Delta
        local sensitivity = 0.003
        cameraRotX = cameraRotX - delta.X * sensitivity
        cameraRotY = math.clamp(cameraRotY - delta.Y * sensitivity, -math.pi/2 + 0.01, math.pi/2 - 0.01)
    end
end)

-- Shortcut Keyboard ([M] untuk Floating Menu, [E] View, [R] Reset)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.M then
        toggleMenuVisibility()
    elseif input.KeyCode == Enum.KeyCode.E then
        toggleViewAction()
    elseif input.KeyCode == Enum.KeyCode.R then
        resetAction()
    end
end)
