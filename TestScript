local function spawnCCTVAction()
    if activeCCTV then activeCCTV:Destroy() end
    local camCFrame = CurrentCamera.CFrame
    initialCFrame = camCFrame
    local char = LocalPlayer.Character
    local rootPart = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if rootPart then
        initialSpawnDistance = (camCFrame.Position - rootPart.Position).Magnitude
        if initialSpawnDistance < 10 then initialSpawnDistance = 50 end
    end
    local block = Instance.new("Part")
    block.Name = "CCTV_Block"
    block.Size = Vector3.new(1, 1, 1)
    block.CFrame = camCFrame
    block.Anchored = true
    block.CanCollide = false
    block.Material = Enum.Material.Neon
    block.Color = Color3.fromRGB(255, 0, 50)
    block.Transparency = showVisualParts and 0.3 or 1
    block.Parent = Workspace
    activeCCTV = block
    local lookVector = camCFrame.LookVector
    cameraRotX = math.atan2(-lookVector.X, -lookVector.Z)
    cameraRotY = math.asin(math.clamp(lookVector.Y, -1, 1))
    if isMonitoring then CurrentCamera.CFrame = activeCCTV.CFrame end
end
