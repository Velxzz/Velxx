    task.spawn(function()
        local timePerSegment = pathDuration / #curvePositions
        for _, targetPos in ipairs(curvePositions) do
            if not isPlayingPath or not activeCCTV then break end
            local tweenInfo = TweenInfo.new(timePerSegment, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
            local tween = TweenService:Create(activeCCTV, tweenInfo, {Position = targetPos})
            tween:Play()
            tween.Completed:Wait()
        end
        isPlayingPath = false
        PlayCinematicBtn.Text = "PLAY CINEMATIC PATH"
        PlayCinematicBtn.BackgroundColor3 = Color3.fromRGB(230, 80, 0)
    end)
end)
