RunService:BindToRenderStep("CCTV_Update", Enum.RenderPriority.Camera.Value + 1, function()
    local char = LocalPlayer.Character
    local rootPart = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if centerPart and rootPart then
        centerPart.CFrame = rootPart.CFrame
    end
    if isMonitoring and activeCCTV then
        if isFollowing and rootPart then
            local camPos = activeCCTV.Position
            local targetPos = rootPart.Position
            CurrentCamera.CFrame = CFrame.new(camPos, targetPos)
        else
            if isCamLocked then
                if centerPart then
                    CurrentCamera.CFrame = CFrame.new(activeCCTV.Position, centerPart.Position)
                else
                    CurrentCamera.CFrame = activeCCTV.CFrame
                end
            else
                CurrentCamera.CFrame = CFrame.new(activeCCTV.Position) * CFrame.Angles(0, cameraRotX, 0) * CFrame.Angles(cameraRotY, 0, 0)
            end
        end
        local targetFOV = baseFOV
        if isDistZoomActive and rootPart then
            local currentDistance = (activeCCTV.Position - rootPart.Position).Magnitude
            local distFactor = currentDistance / math.max(initialSpawnDistance, 10)
            if distFactor < 1 then distFactor = 1 end
            local effectiveZoom = zoomLevel * distFactor
            targetFOV = math.clamp(baseFOV / effectiveZoom, 1, baseFOV)
        else
            targetFOV = math.clamp(baseFOV / math.max(zoomLevel, 1), 1, baseFOV)
        end
        if CurrentCamera.FieldOfView ~= targetFOV then
            CurrentCamera.FieldOfView = targetFOV
        end
    end
end)
local activeTouch = nil
local lastTouchPos = Vector2.new()
UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if isMonitoring and not isCamLocked and not isFollowing and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Delta
        cameraRotX = cameraRotX - delta.X * 0.003
        cameraRotY = math.clamp(cameraRotY - delta.Y * 0.003, -math.pi/2 + 0.01, math.pi/2 - 0.01)
    end
end)
UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
    if gameProcessed then return end
    if isMonitoring and not isCamLocked and not isFollowing then
        activeTouch = touch
        lastTouchPos = touch.Position
    end
end)
UserInputService.TouchMoved:Connect(function(touch, gameProcessed)
    if isMonitoring and not isCamLocked and not isFollowing and touch == activeTouch then
        local delta = touch.Position - lastTouchPos
        lastTouchPos = touch.Position
        cameraRotX = cameraRotX - delta.X * 0.005
        cameraRotY = math.clamp(cameraRotY - delta.Y * 0.005, -math.pi/2 + 0.01, math.pi/2 - 0.01)
    end
end)
UserInputService.TouchEnded:Connect(function(touch)
    if touch == activeTouch then activeTouch = nil end
end)