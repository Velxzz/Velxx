local function catmullRom(p0, p1, p2, p3, t)
    local t2 = t * t
    local t3 = t2 * t
    return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
end
local function renderCurvedPath()
    for _, block in ipairs(curveVisualBlocks) do block:Destroy() end
    table.clear(curveVisualBlocks)
    table.clear(curvePositions)
    if #pathPoints < 2 then return end
    local resolution = 25
    local extendedPoints = {}
    table.insert(extendedPoints, pathPoints[1] - (pathPoints[2] - pathPoints[1]))
    for _, pt in ipairs(pathPoints) do table.insert(extendedPoints, pt) end
    table.insert(extendedPoints, pathPoints[#pathPoints] + (pathPoints[#pathPoints] - pathPoints[#pathPoints-1]))
    for i = 2, #extendedPoints - 2 do
        local p0 = extendedPoints[i - 1]
        local p1 = extendedPoints[i]
        local p2 = extendedPoints[i + 1]
        local p3 = extendedPoints[i + 2]
        for step = 0, resolution - 1 do
            local t = step / resolution
            local finalPos = catmullRom(p0, p1, p2, p3, t)
            table.insert(curvePositions, finalPos)
            local curveBlock = Instance.new("Part")
            curveBlock.Name = "Curve_Point"
            curveBlock.Size = Vector3.new(0.5, 0.5, 0.5)
            curveBlock.Position = finalPos
            curveBlock.Anchored = true
            curveBlock.CanCollide = false
            curveBlock.Material = Enum.Material.Neon
            curveBlock.Color = Color3.fromRGB(255, 170, 0)
            curveBlock.Transparency = showVisualParts and 0.4 or 1
            curveBlock.Parent = PathFolder
            table.insert(curveVisualBlocks, curveBlock)
        end
    end
end
