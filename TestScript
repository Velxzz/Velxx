-- System Variables
local activeCCTV = nil
local initialCFrame = nil -- Menyimpan CFrame asli saat di-spawn
local isMonitoring = false
local isCamLocked = true
local zoomLevel = 1
local baseFOV = 70
local cameraRotX = 0
local cameraRotY = 0

local function toggleMenuVisibility()
    MainFrame.Visible = not MainFrame.Visible
end
FloatBtn.MouseButton1Click:Connect(toggleMenuVisibility)

local function updateZoomDisplay()
    ZoomLabel.Text = "Zoom: " .. zoomLevel .. "x"
end

local function stopMonitoring()
    isMonitoring = false
    ToggleViewBtn.Text = "VIEW CCTV: OFF"
    ToggleViewBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    
    CurrentCamera.CameraType = Enum.CameraType.Custom
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    end
    CurrentCamera.FieldOfView = baseFOV
end

local function spawnCCTVAction()
    if activeCCTV then activeCCTV:Destroy() end
    local camCFrame = CurrentCamera.CFrame
    
    initialCFrame = camCFrame -- Menyimpan rotasi/posisi asli spawn
    
    local block = Instance.new("Part")
    block.Name = "CCTV_Block"
    block.Size = Vector3.new(1, 1, 1)
    block.CFrame = camCFrame
    block.Anchored = true
    block.CanCollide = false
    block.Material = Enum.Material.Neon
    block.Color = Color3.fromRGB(255, 0, 50)
    block.Transparency = 0.3
    block.Parent = Workspace
    
    activeCCTV = block
    
    local lookVector = camCFrame.LookVector
    cameraRotX = math.atan2(-lookVector.X, -lookVector.Z)
    cameraRotY = math.asin(math.clamp(lookVector.Y, -1, 1))
    
    if isMonitoring then CurrentCamera.CFrame = activeCCTV.CFrame end
end
SpawnBtn.MouseButton1Click:Connect(spawnCCTVAction)

local function toggleViewAction()
    if not activeCCTV then return end
    isMonitoring = not isMonitoring
    if isMonitoring then
        ToggleViewBtn.Text = "VIEW CCTV: ON"
        ToggleViewBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        CurrentCamera.CameraType = Enum.CameraType.Scriptable
        
        local lookVector = activeCCTV.CFrame.LookVector
        cameraRotX = math.atan2(-lookVector.X, -lookVector.Z)
        cameraRotY = math.asin(math.clamp(lookVector.Y, -1, 1))
        CurrentCamera.CFrame = activeCCTV.CFrame
        updateZoomDisplay()
    else
        stopMonitoring()
    end
end
ToggleViewBtn.MouseButton1Click:Connect(toggleViewAction)

-- TOGGLE CAMERA LOCK / UNLOCK (Diperbarui agar menyimpan posisi geseran terakhir)
LockCamBtn.MouseButton1Click:Connect(function()
    isCamLocked = not isCamLocked
    if isCamLocked then
        LockCamBtn.Text = "CAMERA LOCK: LOCKED"
        LockCamBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        
        -- Kunci ke arah sudut pandang terakhir hasil pergeseran
        if activeCCTV then
            activeCCTV.CFrame = CFrame.new(activeCCTV.Position) * CFrame.Angles(0, cameraRotX, 0) * CFrame.Angles(cameraRotY, 0, 0)
        end
    else
        LockCamBtn.Text = "CAMERA LOCK: UNLOCKED"
        LockCamBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 200)
        
        local lookVector = CurrentCamera.CFrame.LookVector
        cameraRotX = math.atan2(-lookVector.X, -lookVector.Z)
        cameraRotY = math.asin(math.clamp(lookVector.Y, -1, 1))
    end
end)

-- FITUR BARU: RESET ARAH KAMERA KE SPAWN AWAL
ResetDirBtn.MouseButton1Click:Connect(function()
    if activeCCTV and initialCFrame then
        activeCCTV.CFrame = initialCFrame
        local lookVector = initialCFrame.LookVector
        cameraRotX = math.atan2(-lookVector.X, -lookVector.Z)
        cameraRotY = math.asin(math.clamp(lookVector.Y, -1, 1))
        
        if isMonitoring then
            CurrentCamera.CFrame = activeCCTV.CFrame
        end
    end
end)

ZoomInBtn.MouseButton1Click:Connect(function()
    if not isMonitoring then return end
    zoomLevel = math.min(5, zoomLevel + 1)
    updateZoomDisplay()
end)

ZoomOutBtn.MouseButton1Click:Connect(function()
    if not isMonitoring then return end
    zoomLevel = math.max(1, zoomLevel - 1)
    updateZoomDisplay()
end)

local function resetAction()
    stopMonitoring()
    if activeCCTV then activeCCTV:Destroy(); activeCCTV = nil end
    initialCFrame = nil
end
ResetBtn.MouseButton1Click:Connect(resetAction)

-- Render Priority
RunService:BindToRenderStep("CCTV_Update", Enum.RenderPriority.Camera.Value + 1, function()
    if isMonitoring and activeCCTV then
        if isCamLocked then
            CurrentCamera.CFrame = activeCCTV.CFrame
        else
            CurrentCamera.CFrame = CFrame.new(activeCCTV.Position) * CFrame.Angles(0, cameraRotX, 0) * CFrame.Angles(cameraRotY, 0, 0)
        end
        local targetFOV = baseFOV / zoomLevel
        if CurrentCamera.FieldOfView ~= targetFOV then
            CurrentCamera.FieldOfView = targetFOV
        end
    end
end)

-- Kontrol HP & Mouse
local activeTouch = nil
local lastTouchPos = Vector2.new()

UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if isMonitoring and not isCamLocked and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Delta
        cameraRotX = cameraRotX - delta.X * 0.003
        cameraRotY = math.clamp(cameraRotY - delta.Y * 0.003, -math.pi/2 + 0.01, math.pi/2 - 0.01)
    end
end)

UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
    if gameProcessed then return end
    if isMonitoring and not isCamLocked then
        activeTouch = touch
        lastTouchPos = touch.Position
    end
end)

UserInputService.TouchMoved:Connect(function(touch, gameProcessed)
    if isMonitoring and not isCamLocked and touch == activeTouch then
        local delta = touch.Position - lastTouchPos
        lastTouchPos = touch.Position
        
        cameraRotX = cameraRotX - delta.X * 0.005
        cameraRotY = math.clamp(cameraRotY - delta.Y * 0.005, -math.pi/2 + 0.01, math.pi/2 - 0.01)
    end
end)

UserInputService.TouchEnded:Connect(function(touch)
    if touch == activeTouch then activeTouch = nil end
end)

-- Keyboard Shortcuts
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.M then toggleMenuVisibility()
    elseif input.KeyCode == Enum.KeyCode.E then toggleViewAction()
    elseif input.KeyCode == Enum.KeyCode.R then resetAction() end
end)
