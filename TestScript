local function unfreezeAll()
    for part, wasAnchored in pairs(frozenParts) do
        if part and part:IsA("BasePart") then part.Anchored = wasAnchored end
    end
    table.clear(frozenParts)
    isFrozen = false
    FreezeBtn.Text = "FREEZE CHAR/VEH: OFF"
    FreezeBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 170)
end
local function freezeAll()
    local char = LocalPlayer.Character
    if not char then return end
    table.clear(frozenParts)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            frozenParts[part] = part.Anchored
            part.Anchored = true
        end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then
        local vehicleModel = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if vehicleModel then
            for _, part in ipairs(vehicleModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    frozenParts[part] = part.Anchored
                    part.Anchored = true
                end
            end
        end
    end
    isFrozen = true
    FreezeBtn.Text = "FREEZE CHAR/VEH: ON"
    FreezeBtn.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
end
