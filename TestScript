-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local CurrentCamera = Workspace.CurrentCamera

-- Container GUI Aman
local parentContainer
if gethui then
    parentContainer = gethui()
else
    local success, core = pcall(function() return game:GetService("CoreGui") end)
    parentContainer = (success and core) or LocalPlayer:WaitForChild("PlayerGui")
end

-- Clean Up GUI Lama
local oldGui = parentContainer:FindFirstChild("CCTVSystemGui")
if oldGui then oldGui:Destroy() end

-- ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CCTVSystemGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = parentContainer

-- Frame Utama
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 200, 0, 210)
MainFrame.Position = UDim2.new(0.05, 0, 0.3, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true

local UICorner = Instance.new("UICorner", MainFrame)
UICorner.CornerRadius = UDim.new(0, 8)

-- Header Title
local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "CCTV MONITOR SYSTEM"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 11
Title.BackgroundTransparency = 1

-- Layout UI
local UIList = Instance.new("UIListLayout", MainFrame)
UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIList.Padding = UDim.new(0, 5)
UIList.SortOrder = Enum.SortOrder.LayoutOrder

Title.LayoutOrder = 1

-- Helper Function Tombol
local function createButton(text, color, order)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 28)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    
    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 5)
    return btn
end

-- Buttons
local SpawnBtn = createButton("SPAWN CCTV (Cam Pos)", Color3.fromRGB(0, 150, 255), 2)
local ToggleViewBtn = createButton("VIEW CCTV: OFF", Color3.fromRGB(200, 50, 50), 3)

-- Zoom Container
local ZoomFrame = Instance.new("Frame", MainFrame)
ZoomFrame.Size = UDim2.new(0.9, 0, 0, 28)
ZoomFrame.BackgroundTransparency = 1
ZoomFrame.LayoutOrder = 4

local ZoomInBtn = Instance.new("TextButton", ZoomFrame)
ZoomInBtn.Size = UDim2.new(0.48, 0, 1, 0)
ZoomInBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
ZoomInBtn.Text = "ZOOM IN (+)"
ZoomInBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ZoomInBtn.Font = Enum.Font.GothamBold
ZoomInBtn.TextSize = 9
Instance.new("UICorner", ZoomInBtn).CornerRadius = UDim.new(0, 5)

local ZoomOutBtn = Instance.new("TextButton", ZoomFrame)
ZoomOutBtn.Size = UDim2.new(0.48, 0, 1, 0)
ZoomOutBtn.Position = UDim2.new(0.52, 0, 0, 0)
ZoomOutBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
ZoomOutBtn.Text = "ZOOM OUT (-)"
ZoomOutBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ZoomOutBtn.Font = Enum.Font.GothamBold
ZoomOutBtn.TextSize = 9
Instance.new("UICorner", ZoomOutBtn).CornerRadius = UDim.new(0, 5)

local ResetBtn = createButton("RESET CCTV", Color3.fromRGB(180, 40, 40), 5)

-- System Variables
local activeCCTV = nil
local isMonitoring = false
local defaultFOV = 70
local currentFOV = 70

-- Function Stop Monitoring (Kembali ke Kamera Pemain)
local function stopMonitoring()
    isMonitoring = false
    ToggleViewBtn.Text = "VIEW CCTV: OFF"
    ToggleViewBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    
    CurrentCamera.CameraType = Enum.CameraType.Custom
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    end
    CurrentCamera.FieldOfView = defaultFOV
end

-- Spawn CCTV (Tetap Menyimpan Posisi Kamera Tanpa Menghapus Fitur Pantau)
SpawnBtn.MouseButton1Click:Connect(function()
    if activeCCTV then
        activeCCTV:Destroy()
        activeCCTV = nil
    end
    
    local camCFrame = CurrentCamera.CFrame
    
    local block = Instance.new("Part")
    block.Name = "CCTV_Block"
    block.Size = Vector3.new(1, 1, 1)
    block.CFrame = camCFrame
    block.Anchored = true
    block.CanCollide = false
    block.Material = Enum.Material.Neon
    block.Color = Color3.fromRGB(255, 0, 50)
    block.Transparency = 0.3
    block.Parent = Workspace
    
    activeCCTV = block
    
    if isMonitoring then
        CurrentCamera.CFrame = activeCCTV.CFrame
    end
end)

-- Toggle View CCTV (Ganti Mode Pandang Bebas Bolak-Balik)
ToggleViewBtn.MouseButton1Click:Connect(function()
    if not activeCCTV then return end
    
    isMonitoring = not isMonitoring
    if isMonitoring then
        ToggleViewBtn.Text = "VIEW CCTV: ON"
        ToggleViewBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        CurrentCamera.CameraType = Enum.CameraType.Scriptable
        CurrentCamera.CFrame = activeCCTV.CFrame
        CurrentCamera.FieldOfView = currentFOV
    else
        stopMonitoring()
    end
end)

-- Zoom In/Out
ZoomInBtn.MouseButton1Click:Connect(function()
    if not isMonitoring then return end
    currentFOV = math.max(10, currentFOV - 10)
    CurrentCamera.FieldOfView = currentFOV
end)

ZoomOutBtn.MouseButton1Click:Connect(function()
    if not isMonitoring then return end
    currentFOV = math.min(120, currentFOV + 10)
    CurrentCamera.FieldOfView = currentFOV
end)

-- Reset CCTV (Menghapus Blok & Mematikan Mode Pantau)
ResetBtn.MouseButton1Click:Connect(function()
    stopMonitoring()
    if activeCCTV then
        activeCCTV:Destroy()
        activeCCTV = nil
    end
end)
