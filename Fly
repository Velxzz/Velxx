local function TypeTitle()
	local text = "SYSTEM DASHBOARD"
	TitleText.Text = ""
	for i = 1, #text do
		TitleText.Text = string.sub(text, 1, i) .. "_"
		task.wait(0.03)
	end
	TitleText.Text = text
end

local function OpenUI()
	ScreenGui.Enabled = true
	MainFrame.Size = UDim2.new(0, 380, 0, 0)
	TweenService:Create(Backdrop, TweenInfo.new(0.3), {BackgroundTransparency = 0.5}):Play()
	local openTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 380, 0, 300)})
	openTween:Play()
	task.spawn(TypeTitle)
end

-- Toggle UI via tombol RightControl
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.RightControl then
		if ScreenGui.Enabled then
			CloseUI()
		else
			OpenUI()
		end
	end
end)

-- Buka UI pertama kali
OpenUI()
