local function CloseUI()
	local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 380, 0, 0)})
	TweenService:Create(Backdrop, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
	closeTween:Play()
	closeTween.Completed:Connect(function()
		ScreenGui.Enabled = false
	end)
end

CloseBtn.MouseButton1Click:Connect(CloseUI)

