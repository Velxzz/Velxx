local function sensorCarName(name)
    local len = #name
    if len <= 2 then
        return string.sub(name, 1, 1) .. "*"
    elseif len <= 4 then
        return string.sub(name, 1, 1) .. "**" .. string.sub(name, len, len)
    else
        return string.sub(name, 1, 1) .. "***" .. string.sub(name, len - 2, len)
    end
end

