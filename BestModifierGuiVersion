-- Reset
local function resetAll()
    if not activeFeatures then return end
    isRunning = false
    StartToggleBtn.Text = "OFF"
    StartToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    if FloatStart then FloatStart.Text = "Start" end
    currentIndex = 1
    lastPos = nil
    startingCFrame = nil
    currentTransitionTime = 0
    for _, block in ipairs(spawnedBlocks) do
        if block then block:Destroy() end
    end
    spawnedBlocks = {}
    setTemporaryStatus("Reseted!", 1.5)
end

-- LOGIKA REMOVE TIRE (UNIVERSAL UNTUK MOTOR SIAPA SAJA)
local function removeTire()
    if not activeFeatures then return end
    
    local char = LocalPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or not humanoid.SeatPart then
        setTemporaryStatus("Sit on a bike first!", 2)
        return
    end

    -- Otomatis ambil Model Motor yang diduduki
    local carModel = humanoid.SeatPart:FindFirstAncestorOfClass("Model")
    if not carModel then
        setTemporaryStatus("Bike model not found!", 2)
        return
    end

    local bodyFolder = carModel:FindFirstChild("Body")
    if not bodyFolder then
        setTemporaryStatus("Body folder not found!", 2)
        return
    end

    -- Hapus komponen target tanpa menghapus Weight dan bal
    local targets = {
        "RearSuspensionBase",
        "RearSuspensionBaseHinge",
        "SwingArmHinge"
    }

    for _, name in ipairs(targets) do
        local obj = bodyFolder:FindFirstChild(name)
        if obj then
            obj:Destroy()
        end
    end

    -- Khusus SteeringHinge, hanya hapus file Attachment-nya
    local steeringHinge = bodyFolder:FindFirstChild("SteeringHinge")
    if steeringHinge then
        local att = steeringHinge:FindFirstChild("Attachment")
        if att then
            att:Destroy()
        end
    end

    setTemporaryStatus("Tire Removed from " .. carModel.Name .. "!", 2.5)
end

