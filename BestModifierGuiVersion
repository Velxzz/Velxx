local function removeTire()
    if not activeFeatures then return end

    local char = LocalPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or not humanoid.SeatPart then
        setTemporaryStatus("Sit on a bike first!", 2)
        return
    end

    local carModel = humanoid.SeatPart:FindFirstAncestorOfClass("Model")
    if not carModel then
        setTemporaryStatus("Bike model not found!", 2)
        return
    end

    local bodyFolder = carModel:FindFirstChild("Body")
    if not bodyFolder then
        setTemporaryStatus("Body folder not found!", 2)
        return
    end

    local targets = {"RearSuspensionBase", "RearSuspensionBaseHinge", "SwingArmHinge"}

    for _, name in ipairs(targets) do
        local obj = bodyFolder:FindFirstChild(name)
        if obj then obj:Destroy() end
    end

    local steeringHinge = bodyFolder:FindFirstChild("SteeringHinge")
    if steeringHinge then
        local att = steeringHinge:FindFirstChild("Attachment")
        if att then att:Destroy() end
    end

    setTemporaryStatus("Tire Removed from " .. sensorCarName(carModel.Name) .. "!", 2.5)
end

