-- Load Config
LoadConfigBtn.MouseButton1Click:Connect(function()
    local codeToLoad = LoadBox.Text:gsub("%s+", "")
    if codeToLoad == "" then
        setTemporaryStatus("Enter code first!", 2)
        return
    end

    local fileName = "ModifierConfigs/" .. codeToLoad .. ".json"
    if readfile and isfile and isfile(fileName) then
        local successRead, rawData = pcall(readfile, fileName)
        if not successRead or not rawData then
            setTemporaryStatus("Failed to read file!", 2)
            return
        end

        for _, block in ipairs(spawnedBlocks) do
            if block then block:Destroy() end
        end
        spawnedBlocks = {}
        isRunning = false
        StartToggleBtn.Text = "OFF"
        StartToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        if FloatStart then FloatStart.Text = "Start" end
        currentIndex = 1
        lastPos = nil
        startingCFrame = nil
        currentTransitionTime = 0

        local successDecode, decodedData = pcall(function()
            return HttpService:JSONDecode(rawData)
        end)

        if successDecode and type(decodedData) == "table" then
            for _, comps in ipairs(decodedData) do
                local cf = CFrame.new(table.unpack(comps))
                createVisualBlock(cf)
            end

            if #spawnedBlocks > 0 then
                lastPos = spawnedBlocks[#spawnedBlocks].Position
            end
            setTemporaryStatus("Loaded Successfully!", 2)
        else
            setTemporaryStatus("Invalid Config Format!", 2)
        end
    else
        setTemporaryStatus("Code not found!", 2)
    end
end)

-- Heartbeat Loop (Teleport / Speed Logic)
RunService.Heartbeat:Connect(function(dt)
    if not activeFeatures or not isRunning or #spawnedBlocks == 0 then return end

    local speedVal = getSpeedValue()
    local char = LocalPlayer.Character
    if not char then return end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local targetPart = (humanoid and humanoid.SeatPart) or rootPart

    if targetPart then
        if targetPart:IsA("BasePart") then
            targetPart.AssemblyLinearVelocity = Vector3.zero
            targetPart.AssemblyAngularVelocity = Vector3.zero
        end

        local targetBlock = spawnedBlocks[currentIndex]
        if targetBlock then
            local targetCFrame = targetBlock.CFrame

            if speedVal == 0 then
                targetPart.CFrame = targetCFrame
                currentIndex = currentIndex + 1
                if currentIndex > #spawnedBlocks then
                    currentIndex = 1
                end
                startingCFrame = nil
            else
                if not startingCFrame then
                    startingCFrame = targetPart.CFrame
                    currentTransitionTime = 0
                end

                currentTransitionTime = currentTransitionTime + dt

                if currentTransitionTime >= speedVal then
                    targetPart.CFrame = targetCFrame
                    currentIndex = currentIndex + 1
                    if currentIndex > #spawnedBlocks then
                        currentIndex = 1
                    end
                    startingCFrame = nil
                else
                    local alpha = currentTransitionTime / speedVal
                    targetPart.CFrame = startingCFrame:Lerp(targetCFrame, alpha)
                end
            end
        end
    end
end)