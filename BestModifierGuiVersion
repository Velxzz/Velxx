local spawnedBlocks = {}
local currentIndex = 1
local lastPos = nil
local startingCFrame = nil
local currentTransitionTime = 0

local function createVisualBlock(cf)
    local block = Instance.new("Part")
    block.Size = Vector3.new(1, 10, 1)
    block.CFrame = cf
    block.Anchored = true
    block.CanCollide = false
    block.Transparency = 0.5
    block.Material = Enum.Material.SmoothPlastic
    block.Color = Color3.fromRGB(255, 255, 255)

    local texture = Instance.new("Texture")
    texture.Face = Enum.NormalId.Top
    texture.Texture = "rbxassetid://620583021"
    texture.Parent = block

    block.Parent = workspace
    table.insert(spawnedBlocks, block)
    return block
end

local function setTemporaryStatus(msg, duration)
    customStatusText = msg
    task.delay(duration or 2, function()
        if customStatusText == msg then
            customStatusText = nil
        end
    end)
end

local function clearAllBlocks()
    isRunning = false
    StartToggleBtn.Text = "OFF"
    StartToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    currentIndex = 1
    lastPos = nil
    startingCFrame = nil
    currentTransitionTime = 0
    for _, block in ipairs(spawnedBlocks) do
        if block then block:Destroy() end
    end
    spawnedBlocks = {}
end

local function loadPresetFromUrl(url, trackName)
    if not url then
        setTemporaryStatus("Config " .. trackName .. " belum dibuat!", 2)
        return
end

    setTemporaryStatus("Loading " .. trackName .. "...", 5)

    task.spawn(function()
        local success, result = pcall(function()
            return game:HttpGet(url)
        end)

        if success and result then
            local successDecode, decodedData = pcall(function()
                return HttpService:JSONDecode(result)
            end)

            if successDecode and type(decodedData) == "table" then
                clearAllBlocks()

                for _, comps in ipairs(decodedData) do
                    local cf = CFrame.new(table.unpack(comps))
                    createVisualBlock(cf)
                end

                if #spawnedBlocks > 0 then
                    lastPos = spawnedBlocks[#spawnedBlocks].Position
                end
                setTemporaryStatus("Loaded " .. trackName .. " (" .. #spawnedBlocks .. " Blocks)", 2.5)
            else
                setTemporaryStatus("Failed to parse JSON data!", 2)
            end
        else
            setTemporaryStatus("Failed to download config!", 2)
        end
    end)
end

