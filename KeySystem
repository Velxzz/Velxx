-- Services
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Configuration
local MAX_SAMPLES = 30 -- Jumlah batang pada grafik
local MAX_FPS = 60      -- Batas atas skala grafik FPS
local GRAPH_HEIGHT = 40 -- Tinggi grafik dalam piksel

-- 1. Membuat GUI Utama
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "PerformanceStatsGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

-- Frame Container (Pojok Kanan Atas)
local container = Instance.new("Frame")
container.Name = "MainContainer"
container.Size = UDim2.new(0, 160, 0, 75)
-- Menggunakan AnchorPoint dan Position kanan atas
container.AnchorPoint = Vector2.new(1, 0)
container.Position = UDim2.new(1, -10, 0, 10)
container.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
container.BackgroundTransparency = 0.2
container.BorderSizePixel = 0
container.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = container

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 6)
padding.PaddingBottom = UDim.new(0, 6)
padding.PaddingLeft = UDim.new(0, 8)
padding.PaddingRight = UDim.new(0, 8)
padding.Parent = container

-- Text Label untuk Angka FPS
local fpsLabel = Instance.new("TextLabel")
fpsLabel.Name = "FpsLabel"
fpsLabel.Size = UDim2.new(1, 0, 0, 20)
fpsLabel.BackgroundTransparency = 1
fpsLabel.Font = Enum.Font.SourceSansBold
fpsLabel.TextSize = 16
fpsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
fpsLabel.TextXAlignment = Enum.TextXAlignment.Left
fpsLabel.Text = "FPS: 60"
fpsLabel.Parent = container

-- Frame Container Grafik
local graphFrame = Instance.new("Frame")
graphFrame.Name = "GraphFrame"
graphFrame.Size = UDim2.new(1, 0, 0, GRAPH_HEIGHT)
graphFrame.Position = UDim2.new(0, 0, 0, 24)
graphFrame.BackgroundTransparency = 1
graphFrame.Parent = container

local uiListLayout = Instance.new("UIListLayout")
uiListLayout.FillDirection = Enum.FillDirection.Horizontal
uiListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
uiListLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
uiListLayout.Padding = UDim.new(0, 1)
uiListLayout.Parent = graphFrame

-- 2. Membuat Batang Grafik (Bar Pools)
local bars = {}
local sampleHistory = {}

for i = 1, MAX_SAMPLES do
	local bar = Instance.new("Frame")
	bar.Name = "Bar_" .. i
	bar.Size = UDim2.new(1 / MAX_SAMPLES, -1, 0, 2)
	bar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
	bar.BorderSizePixel = 0
	bar.Parent = graphFrame
	
	table.insert(bars, bar)
	table.insert(sampleHistory, 60) -- Inisialisasi awal pada 60 FPS
end

-- Function Penentu Warna Berdasarkan FPS
local function getFpsColor(fps)
	if fps >= 50 then
		return Color3.fromRGB(0, 255, 120) -- Hijau (Lancar)
	elseif fps >= 30 then
		return Color3.fromRGB(255, 200, 0) -- Kuning (Sedang)
	else
		return Color3.fromRGB(255, 50, 50)   -- Merah (Patah-patah)
	end
end

-- 3. Kalkulasi FPS dan Update UI setiap Frame
local frameTimes = {}

RunService.RenderStepped:Connect(function(deltaTime)
	-- Hitung kalkulasi rata-rata FPS 1 detik terakhir
	local now = os.clock()
	table.insert(frameTimes, now)
	
	while frameTimes[1] and frameTimes[1] < now - 1 do
		table.remove(frameTimes, 1)
	end
	
	local currentFps = math.clamp(#frameTimes, 0, MAX_FPS)
	
	-- Update Teks Angka
	fpsLabel.Text = string.format("FPS: %d", currentFps)
	fpsLabel.TextColor3 = getFpsColor(currentFps)
	
	-- Geser Data Grafik ke Kiri
	table.remove(sampleHistory, 1)
	table.insert(sampleHistory, currentFps)
	
	-- Render Ulang Batang Grafik
	for i = 1, MAX_SAMPLES do
		local val = sampleHistory[i]
		local heightScale = math.clamp(val / MAX_FPS, 0.05, 1)
		
		bars[i].Size = UDim2.new(1 / MAX_SAMPLES, -1, heightScale, 0)
		bars[i].BackgroundColor3 = getFpsColor(val)
	end
end)
