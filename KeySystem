-- Services
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Configurations
local MAX_SAMPLES = 30
local STANDARD_GRAVITY = 196.2

-- 1. Membuat GUI Utama
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VehicleBarsGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

local container = Instance.new("Frame")
container.Name = "MainContainer"
container.Size = UDim2.new(0, 180, 0, 150)
container.AnchorPoint = Vector2.new(1, 0)
container.Position = UDim2.new(1, -10, 0, 10)
container.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
container.BackgroundTransparency = 0.2
container.BorderSizePixel = 0
container.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = container

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 8)
padding.PaddingBottom = UDim.new(0, 8)
padding.PaddingLeft = UDim.new(0, 8)
padding.PaddingRight = UDim.new(0, 8)
padding.Parent = container

-- Text Label Ringkas
local infoLabel = Instance.new("TextLabel")
infoLabel.Name = "InfoLabel"
infoLabel.Size = UDim2.new(1, 0, 0, 50)
infoLabel.BackgroundTransparency = 1
infoLabel.Font = Enum.Font.SourceSansBold
infoLabel.TextSize = 13
infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
infoLabel.TextXAlignment = Enum.TextXAlignment.Left
infoLabel.TextYAlignment = Enum.TextYAlignment.Top
infoLabel.Text = "Speed: 0 km/h\nDownforce: 0.00 G\nUpforce: 0.00 G"
infoLabel.Parent = container

-- Container Grafik Batang (Wave Graph)
local graphFrame = Instance.new("Frame")
graphFrame.Name = "GraphFrame"
graphFrame.Size = UDim2.new(1, 0, 0, 50)
graphFrame.Position = UDim2.new(0, 0, 0, 55)
graphFrame.BackgroundTransparency = 1
graphFrame.Parent = container

local uiListLayout = Instance.new("UIListLayout")
uiListLayout.FillDirection = Enum.FillDirection.Horizontal
uiListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
uiListLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
uiListLayout.Padding = UDim.new(0, 1)
uiListLayout.Parent = graphFrame

-- 2. Membuat Pool Batang Grafik
local bars = {}
local sampleHistory = {}

for i = 1, MAX_SAMPLES do
    local bar = Instance.new("Frame")
    bar.Name = "Bar_" .. i
    bar.Size = UDim2.new(1 / MAX_SAMPLES, -1, 0.05, 0)
    bar.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    bar.BorderSizePixel = 0
    bar.Parent = graphFrame

    table.insert(bars, bar)
    table.insert(sampleHistory, 0.05)
end

-- Variables Fisika
local lastVelocity = Vector3.new(0, 0, 0)

-- 3. Loop Logika Realtime
RunService.Heartbeat:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    if not char then return end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    if humanoid and humanoid.SeatPart then
        rootPart = humanoid.SeatPart.AssemblyRootPart or humanoid.SeatPart
    end
    
    if not rootPart then return end

    -- Hitung Kecepatan & G-Force
    local currentVelocity = rootPart.AssemblyLinearVelocity
    local speedKmH = math.floor(currentVelocity.Magnitude * 0.28)

    local acceleration = (currentVelocity - lastVelocity) / deltaTime
    lastVelocity = currentVelocity

    local verticalAcc = acceleration.Y
    local gForceVertical = verticalAcc / STANDARD_GRAVITY

    local downForceG = gForceVertical < 0 and math.abs(gForceVertical) or 0
    local upForceG = gForceVertical > 0 and gForceVertical or 0

    -- Update Text Display
    infoLabel.Text = string.format(
        "Speed: %d km/h\nDownforce: %.2f G\nUpforce: %.2f G",
        speedKmH,
        downForceG,
        upForceG
    )

    -- Hitung Tinggi Batang (Kombinasi Speed & Downforce secara langsung)
    table.remove(sampleHistory, 1)
    
    -- Nilai gabungan: Kecepatan memicu tinggi dasar, Downforce memicu lonjakan puncak
    local rawScale = (speedKmH / 350) + (downForceG * 0.7)
    local barHeightScale = math.clamp(rawScale, 0.05, 1)
    
    table.insert(sampleHistory, barHeightScale)

    -- Render Ulang Warna & Tinggi Batang dari Kanan ke Kiri
    for i = 1, MAX_SAMPLES do
        local val = sampleHistory[i]
        bars[i].Size = UDim2.new(1 / MAX_SAMPLES, -1, val, 0)

        -- Warna berubah sesuai dinamika pengereman/kecepatan
        if val > 0.75 then
            bars[i].BackgroundColor3 = Color3.fromRGB(255, 50, 50)  -- Merah (Rem Keras / Downforce Tinggi)
        elseif val > 0.4 then
            bars[i].BackgroundColor3 = Color3.fromRGB(255, 180, 0) -- Kuning (Kecepatan Tinggi)
        else
            bars[i].BackgroundColor3 = Color3.fromRGB(0, 200, 255) -- Biru (Normal)
        end
    end
end)
