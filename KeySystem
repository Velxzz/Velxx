        if not isFeaturesActive then return end

        local seat, carModel = getCurrentVehicle()

        if seat and carModel then
            local vel = seat.AssemblyLinearVelocity

            if vel.Y > 8 or vel.Y < -15 then
                seat.AssemblyLinearVelocity = Vector3.new(vel.X, math.clamp(vel.Y, -10, 5), vel.Z)
            end

            CarLabel.Text = "Car: " .. carModel.Name

            if defaultFrictionVal == nil then
                local currentProp = seat.CustomPhysicalProperties or PhysicalProperties.new(seat.Material)

                if currentProp.Density > 0.05 then
                    defaultDensity = currentProp.Density
     end

                defaultFrictionVal = currentProp.Friction
                defaultFrictionWeightVal = currentProp.FrictionWeight
                DensityBox.Text = tostring(defaultDensity or 0.1)
            end

            local gyro = carModel:FindFirstChild("LeanGyro", true)
            if gyro then
                if activeBodyGyro ~= gyro then
                    activeBodyGyro = gyro
                    if gyro.P > 0 then defaultP = gyro.P end
                    if gyro.D > 0 then defaultD = gyro.D end
                    if gyro.MaxTorque.Z > 0 then defaultTorqueZ = gyro.MaxTorque.Z end

                    SteerBoxP.Text = tostring(defaultP or gyro.P)
                    SteerBoxD.Text = tostring(defaultD or gyro.D)
                    SteerBoxTorque.Text = tostring(defaultTorqueZ or gyro.MaxTorque.Z)
                end

                if isSteerSettingActive then
                    local targetP = tonumber(SteerBoxP.Text)
                    local targetD = tonumber(SteerBoxD.Text)
                    local targetTorqueZ = tonumber(SteerBoxTorque.Text)

                    if targetP and targetP > 0 then
                        gyro.P = targetP
                    end
                    if targetD and targetD > 0 then
                        gyro.D = targetD
                    end
                    if targetTorqueZ and targetTorqueZ > 0 then
                        gyro.MaxTorque = Vector3.new(0, 0, targetTorqueZ)
                    end
                end
            end
        else
            activeBodyGyro = nil
            CarLabel.Text = "Car: None"
            defaultFrictionVal = nil
            defaultFrictionWeightVal = nil
        end
    end)
