local availableUsernames = {}
local letters = "abcdefghijklmnopqrstuvwxyz"
local numbers = "0123456789"
local isRunning = false
local useUnderscore = false
local totalCheckedCount = 0

-- Fitur Start / Stop Toggle
StartStopBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        StartStopBtn.Text = "START"
        StartStopBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        StartStopBtn.Text = "STOP"
        StartStopBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

-- Toggle Options Underscore (Yes/No)
UnderscoreBtn.MouseButton1Click:Connect(function()
    useUnderscore = not useUnderscore
    if useUnderscore then
        UnderscoreBtn.Text = "Yes"
        UnderscoreBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    else
        UnderscoreBtn.Text = "No"
        UnderscoreBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    end
    
    local numL = tonumber(LetterBox.Text) or 0
    local numN = tonumber(NumberBox.Text) or 0
    DigitBox.Text = tostring(numL + numN + (useUnderscore and 1 or 0))
end)

-- Update Total Digit Box
local function updateDigitBox()
    local numL = tonumber(LetterBox.Text) or 0
    local numN = tonumber(NumberBox.Text) or 0
    local extra = useUnderscore and 1 or 0
    DigitBox.Text = tostring(numL + numN + extra)
end

LetterBox:GetPropertyChangedSignal("Text"):Connect(updateDigitBox)
NumberBox:GetPropertyChangedSignal("Text"):Connect(updateDigitBox)

-- Pengecekan Ketersediaan Username ke API Roblox
local function checkUsername(username)
    local success, result = pcall(function()
        local url = "https://users.roblox.com/v1/usernames/users"
        local body = HttpService:JSONEncode({
            usernames = {username},
            excludeBannedUsers = false
        })
        
        local response
        if request then
            response = request({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
        elseif syn and syn.request then
            response = syn.request({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
        elseif http_request then
            response = http_request({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
        end
        
        if response and response.Body then
            local data = HttpService:JSONDecode(response.Body)
            return #data.data == 0
        end
        return false
    end)
    return success and result
end

-- Generator Acak (dengan logika Underscore aman)
local function generateRandomUsername(numLetters, numNumbers, includeUnderscore)
    local charTable = {}
    for i = 1, numLetters do
        local randIndex = math.random(1, #letters)
        table.insert(charTable, string.sub(letters, randIndex, randIndex))
    end
    for i = 1, numNumbers do
        local randIndex = math.random(1, #numbers)
        table.insert(charTable, string.sub(numbers, randIndex, randIndex))
    end
    
    -- Acak urutan alfanumerik terlebih dahulu
    for i = #charTable, 2, -1 do
        local j = math.random(i)
        charTable[i], charTable[j] = charTable[j], charTable[i]
    end
    
    -- Jika Underscore diaktifkan, sisipkan 1 underscore di tengah-tengah (bukan index awal/akhir)
    if includeUnderscore and #charTable >= 2 then
        local insertIndex = math.random(2, #charTable)
        table.insert(charTable, insertIndex, "_")
    end
    
    return table.concat(charTable)
end

-- Tambah Output Log ke UI
local function addOutputLog(username, isAvailable)
    totalCheckedCount = totalCheckedCount + 1
    
    local item = Instance.new("TextLabel", ScrollOutput)
    item.Size = UDim2.new(1, 0, 0, 18)
    item.BackgroundTransparency = 1
    item.Font = Enum.Font.GothamBold
    item.TextSize = 11
    item.TextXAlignment = Enum.TextXAlignment.Left

    if isAvailable then
        item.Text = string.format("%d. %s - Available", totalCheckedCount, username)
        item.TextColor3 = Color3.fromRGB(0, 255, 50)
        table.insert(availableUsernames, username)
    else
        item.Text = string.format("%d. %s - Used", totalCheckedCount, username)
        item.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end

-- Simpan ke File (Appends ke baris paling bawah)
local function saveToFile(username)
    if appendfile then
        appendfile("AvailableUsername.txt", username .. "\n")
    elseif writefile and isfile then
        if isfile("AvailableUsername.txt") then
            local oldContent = readfile("AvailableUsername.txt")
            writefile("AvailableUsername.txt", oldContent .. username .. "\n")
        else
            writefile("AvailableUsername.txt", username .. "\n")
        end
    end
end

-- Tombol Copy Clipboard
CopyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(table.concat(availableUsernames, "\n"))
        CopyBtn.Text = "Copied!"
        task.wait(1.5)
        CopyBtn.Text = "Clipboard"
    end
end)

-- Tombol Manual Save File
FileBtn.MouseButton1Click:Connect(function()
    for _, usn in ipairs(availableUsernames) do
        saveToFile(usn)
    end
    FileBtn.Text = "Saved!"
    task.wait(1.5)
    FileBtn.Text = "File"
end)

-- Loop Utama Pengecekan Otomatis
task.spawn(function()
    while true do
        if isRunning then
            local numL = tonumber(LetterBox.Text) or 4
            local numN = tonumber(NumberBox.Text) or 1
            
            local generatedUsn = generateRandomUsername(numL, numN, useUnderscore)
            local isAvailable = checkUsername(generatedUsn)
            
            addOutputLog(generatedUsn, isAvailable)
            
            if isAvailable then
                saveToFile(generatedUsn)
            end
        end
        task.wait(1.5)
    end
end)
