local function removeTireMod()
    if not modActive then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then setTemporaryStatus("Sit on bike!", 2) return end

    local carModel = hum.SeatPart:FindFirstAncestorOfClass("Model")
    local bodyFolder = carModel and carModel:FindFirstChild("Body")
    if bodyFolder then
        for _, name in ipairs({"RearSuspensionBase", "RearSuspensionBaseHinge", "SwingArmHinge"}) do
            local obj = bodyFolder:FindFirstChild(name)
            if obj then obj:Destroy() end
        end
        local steeringHinge = bodyFolder:FindFirstChild("SteeringHinge")
        if steeringHinge and steeringHinge:FindFirstChild("Attachment") then
            steeringHinge.Attachment:Destroy()
        end
        setTemporaryStatus("Tire Removed!", 2)
    end
end

