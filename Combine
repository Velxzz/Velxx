local settingsFileName = "ModifierConfigs/UserSettings.json"
local function saveSettings()
    if writefile then
        local success, encoded = pcall(function() return HttpService:JSONEncode(Settings) end)
        if success then writefile(settingsFileName, encoded) end
    end
end

local function loadSettings()
    if readfile and isfile(settingsFileName) then
        local success, decoded = pcall(function() return HttpService:JSONDecode(readfile(settingsFileName)) end)
        if success and type(decoded) == "table" then
            for k, v in pairs(decoded) do if Settings[k] ~= nil then Settings[k] = v end end
        end
    end
end
