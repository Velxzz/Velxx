-- 1. MODULE: MAID1
local Maid1 = {}
Maid1.__index = Maid1
function Maid1.new() return setmetatable({ trash = {} }, Maid1) end
function Maid1:Mark(task) table.insert(self.trash, task) end
function Maid1:Sweep()
    for _, task in ipairs(self.trash) do
        if typeof(task) == "RBXScriptConnection" then task:Disconnect()
        elseif typeof(task) == "Instance" then task:Destroy()
        elseif typeof(task) == "function" then task() end
    end
    self.trash = {}
end

-- 2. MODULE: SPRING1
local Spring1 = {}
Spring1.__index = Spring1
function Spring1.new(freq, damping, response, initialValue)
    local self = setmetatable({}, Spring1)
    response = response or 1
    local dampingFactor = damping * damping / (4 * freq * response * response)
    self.k = freq / dampingFactor
    self.d = -damping / dampingFactor
    self.x = initialValue
    self.t = initialValue
    self.v = initialValue * 0
    return self
end

function Spring1:Update(dt)
    local target, k, d, pos, vel = self.t, self.k, self.d, self.x, self.v
    local a1 = k * (target - pos) + vel * d
    local v1 = vel + a1 * (dt / 2)
    local a2 = k * (target - (pos + vel * (dt / 2))) + v1 * d
    local v2 = vel + a2 * (dt / 2)
    local a3 = k * (target - (pos + v1 * (dt / 2))) + v2 * d
    local v3 = vel + a3 * dt
    self.x = pos + (vel + 2 * (v1 + v2) + v3) * (dt / 6)
    self.v = vel + (a1 + 2 * (a2 + a3) + k * (target - (pos + v2 * dt)) + v3 * d) * (dt / 6)
    return self.x
end

