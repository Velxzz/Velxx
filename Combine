-- Auto-Apply Realtime Settings Callback
local function updateRealtimeSettings()
    Settings.MainWidth = tonumber(WidthBox.Text) or Settings.MainWidth
    Settings.MainHeight = tonumber(HeightBox.Text) or Settings.MainHeight
    Settings.FloatSize = tonumber(FloatSizeBox.Text) or Settings.FloatSize
    Settings.ShortcutSize = tonumber(ShortcutSizeBox.Text) or Settings.ShortcutSize
    Settings.MainTransparency = tonumber(MainAlphaBox.Text) or Settings.MainTransparency
    Settings.FloatTransparency = tonumber(FloatAlphaBox.Text) or Settings.FloatTransparency

    MainFrame.Size = UDim2.new(0, Settings.MainWidth, 0, Settings.MainHeight)
    MainFrame.BackgroundTransparency = math.clamp(Settings.MainTransparency, 0, 100) / 100
    MenuShortcut.Size = UDim2.new(0, Settings.ShortcutSize, 0, Settings.ShortcutSize)

    for _, btn in ipairs(ScreenGui:GetChildren()) do
        if btn:IsA("TextButton") and btn.Name:find("Float") then
            btn.Size = UDim2.new(0, Settings.FloatSize, 0, Settings.FloatSize)
            btn.BackgroundTransparency = math.clamp(Settings.FloatTransparency, 0, 100) / 100
        end
    end
end

WidthBox.FocusLost:Connect(updateRealtimeSettings)
HeightBox.FocusLost:Connect(updateRealtimeSettings)
FloatSizeBox.FocusLost:Connect(updateRealtimeSettings)
ShortcutSizeBox.FocusLost:Connect(updateRealtimeSettings)
MainAlphaBox.FocusLost:Connect(updateRealtimeSettings)
