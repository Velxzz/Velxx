-- Floating Buttons (Emoji Fixed)
local modFloatButtons = {}
local function createCircularFloat(name, emojiIcon, customPos, callback)
    local btn = Instance.new("TextButton", ScreenGui)
    btn.Name = "Float_" .. name
    btn.Size = UDim2.new(0, Settings.FloatSize, 0, Settings.FloatSize)
    btn.Position = customPos
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    btn.BackgroundTransparency = Settings.FloatTransparency / 100
    btn.Text = emojiIcon
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 18 -- Ukuran emoji lebih jelas
    btn.Active = true
    btn.Draggable = true
    btn.Visible = showModFloat
    table.insert(modFloatButtons, btn)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    btn.MouseButton1Click:Connect(function() if modActive then callback() end end)
    return btn
end

local FloatStart
local function toggleStart()
    if not modActive or #spawnedBlocks == 0 then return end
    modRunning = not modRunning
    ModStartBtn.Text = modRunning and "ON" or "OFF"
    ModStartBtn.BackgroundColor3 = modRunning and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(220, 50, 50)
    if FloatStart then FloatStart.Text = modRunning and "⏸️" or "🚀" end
end

local FastSteerFloatBtn
local function cycleSpeedFloat()
    modifierSpeed = modifierSpeed >= 5 and 1 or (modifierSpeed + 1)
    if SpeedDisplayLabel then SpeedDisplayLabel.Text = tostring(modifierSpeed) end
    if FastSteerFloatBtn then FastSteerFloatBtn.Text = "⚡" .. tostring(modifierSpeed) end
    setTemporaryStatus("Speed: " .. modifierSpeed, 1)
end

