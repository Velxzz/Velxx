-- AUTO EXECUTE VIA HTTPGET ON INITIALIZATION
--------------------------------------------------------------------------------
local function checkAndAutoExecute()
    if not Settings.AutoExecuteEnabled then return end
    local targetName = Settings.AutoExecuteTarget
    if not targetName or targetName == "" then return end

    task.spawn(function()
        task.wait(1)
        for category, tracks in pairs(builtInPresets) do
            for _, item in ipairs(tracks) do
                if item.Name == targetName then
                    fetchAndLoadUrl(item.Url, item.Name)
                    return
                end
            end
        end
    end)
end

checkAndAutoExecute()

