-- Logika Mengambil Data via HttpGet Pastebin
local function fetchAndLoadUrl(url, trackName)
    if not url or url == "" or url:find("XXXXXX") then
        setTemporaryStatus("Link " .. trackName .. " belum diset!", 2)
        return
    end

    setTemporaryStatus("Downloading " .. trackName .. "...", 5)
    
    task.spawn(function()
        local success, response = pcall(function()
            return game:HttpGet(url)
        end)

        if success and response then
            loadConfigFromString(response)
            setTemporaryStatus("Loaded " .. trackName .. "!", 2)
        else
            setTemporaryStatus("Gagal HttpGet!", 2)
        end
    end)
end

