-- Modifier Position Updating
RunService.Heartbeat:Connect(function(dt)
    if not modActive or not modRunning or #spawnedBlocks == 0 then return end

    local speedVal = speedValues[currentSpeedIndex]
    local char = LocalPlayer.Character
    local targetPart = (char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").SeatPart) or (char and char:FindFirstChild("HumanoidRootPart"))

    if targetPart then
        if targetPart:IsA("BasePart") then
            targetPart.AssemblyLinearVelocity = Vector3.zero
            targetPart.AssemblyAngularVelocity = Vector3.zero
        end

        local targetBlock = spawnedBlocks[currentIndex]
        if targetBlock then
            local targetCFrame = targetBlock.CFrame
            if speedVal == 0 then
                targetPart.CFrame = targetCFrame
                currentIndex = currentIndex + 1
                if currentIndex > #spawnedBlocks then currentIndex = 1 end
                startingCFrame = nil
            else
                if not startingCFrame then
                    startingCFrame = targetPart.CFrame
                    currentTransitionTime = 0
                end
                currentTransitionTime = currentTransitionTime + dt
                if currentTransitionTime >= speedVal then
                    targetPart.CFrame = targetCFrame
                    currentIndex = currentIndex + 1
                    if currentIndex > #spawnedBlocks then currentIndex = 1 end
                    startingCFrame = nil
                else
                    local alpha = currentTransitionTime / speedVal
                    targetPart.CFrame = startingCFrame:Lerp(targetCFrame, alpha)
                end
            end
        end
    end
end)

-- Boost Vehicle Adjustments
RunService.Stepped:Connect(function()
    if not boostActive then return end

    local seat, carModel = getCurrentVehicle()
    if seat and carModel then
        local vel = seat.AssemblyLinearVelocity
        if vel.Y > 8 or vel.Y < -15 then
            seat.AssemblyLinearVelocity = Vector3.new(vel.X, math.clamp(vel.Y, -10, 5), vel.Z)
        end

        local gyro = carModel:FindFirstChild("LeanGyro", true)
        if gyro then
            if activeBodyGyro ~= gyro then
                activeBodyGyro = gyro
                if gyro.P > 0 then defaultP = gyro.P end
                if gyro.D > 0 then defaultD = gyro.D end
                if gyro.MaxTorque.Z > 0 then defaultTorqueZ = gyro.MaxTorque.Z end
                SteerBoxP.Text = tostring(defaultP or gyro.P)
                SteerBoxD.Text = tostring(defaultD or gyro.D)
                SteerBoxTorque.Text = tostring(defaultTorqueZ or gyro.MaxTorque.Z)
            end

            if isSteerSettingActive then
                local targetP = tonumber(SteerBoxP.Text)
                local targetD = tonumber(SteerBoxD.Text)
                local targetTorqueZ = tonumber(SteerBoxTorque.Text)
                if targetP and targetP > 0 then gyro.P = targetP end
                if targetD and targetD > 0 then gyro.D = targetD end
                if targetTorqueZ and targetTorqueZ > 0 then gyro.MaxTorque = Vector3.new(0, 0, targetTorqueZ) end
            end
        end
    else
        activeBodyGyro = nil
    end
end)