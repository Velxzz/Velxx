local function clearAllBlocks()
    for _, b in ipairs(spawnedBlocks) do
        if b then b:Destroy() end
    end
    spawnedBlocks = {}
    lastPos = nil
    currentIndex = 1
end

local function createVisualBlock(cf)
    local block = Instance.new("Part")
    block.Size = Vector3.new(1, 10, 1)
    block.CFrame = cf
    block.Anchored = true
    block.CanCollide = false
    block.Transparency = 0.5
    block.Color = Color3.fromRGB(255, 255, 255)
    local tex = Instance.new("Texture", block)
    tex.Face = Enum.NormalId.Top
    tex.Texture = "rbxassetid://620583021"
    block.Parent = workspace
    table.insert(spawnedBlocks, block)
end

local ModStartBtn, SpeedDisplayLabel

local function spawnBlockAtPlayer()
    if not modActive then return end
    local char = LocalPlayer.Character
    local targetPart = (char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").SeatPart) or (char and char:FindFirstChild("HumanoidRootPart"))
    if targetPart then
        local currentPos = targetPart.Position
        local finalCFrame = lastPos and CFrame.fromMatrix(currentPos, (currentPos - lastPos).Unit:Cross(targetPart.CFrame.UpVector).Unit, targetPart.CFrame.UpVector, -(currentPos - lastPos).Unit) or targetPart.CFrame
        lastPos = currentPos
        createVisualBlock(finalCFrame)
        setTemporaryStatus("Spawned!", 1)
    end
end

local function undoLastBlock()
    if #spawnedBlocks > 0 then
        table.remove(spawnedBlocks, #spawnedBlocks):Destroy()
        lastPos = #spawnedBlocks > 0 and spawnedBlocks[#spawnedBlocks].Position or nil
    end
end

local function resetModAll()
    modRunning = false
    if ModStartBtn then
        ModStartBtn.Text = "OFF"
        ModStartBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    end
    clearAllBlocks()
end

local function removeTireFunc()
    local char = LocalPlayer.Character
    local seatPart = char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").SeatPart
    local carModel = seatPart and seatPart:FindFirstAncestorOfClass("Model")
    if carModel then
        local removedCount = 0
        for _, descendant in ipairs(carModel:GetDescendants()) do
            if descendant:IsA("BasePart") and (string.lower(descendant.Name):find("tire") or string.lower(descendant.Name):find("wheel")) then
                descendant:Destroy()
                removedCount = removedCount + 1
            end
        end
        setTemporaryStatus("Removed " .. removedCount .. " tires!", 2)
    else
        setTemporaryStatus("Not in a vehicle!", 2)
    end
end

local function loadConfigFromString(codeStr)
    resetModAll()
    local cleanCode = codeStr:match("{.*}") or codeStr
    local success, result = pcall(function()
        return loadstring("return " .. cleanCode)()
    end)

    if not success or type(result) ~= "table" then
        success, result = pcall(function()
            local func = loadstring(codeStr)
            return func and func()
        end)
    end

    if success and type(result) == "table" then
        for _, posData in ipairs(result) do
            local cf = posData
            if typeof(posData) == "CFrame" then
                cf = posData
            elseif type(posData) == "table" then
                cf = CFrame.new(unpack(posData))
            end
            if typeof(cf) == "CFrame" then
                createVisualBlock(cf)
            end
        end
        if #spawnedBlocks > 0 then lastPos = spawnedBlocks[#spawnedBlocks].Position end
        setTemporaryStatus("Loaded " .. #spawnedBlocks .. " Blocks", 3)
    else
        setTemporaryStatus("Error Parsing Config!", 2)
    end
end

