-- LOGIKA TOUCH JOYSTICK
local joystickTouchInput1 = nil
local centerPos1 = Vector2.new()
local maxRadius1 = 50

JoystickFrame.InputBegan:Connect(function(input)
    if not joystickTouchInput1 and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
        joystickTouchInput1 = input
        centerPos1 = JoystickFrame.AbsolutePosition + JoystickFrame.AbsoluteSize / 2
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == joystickTouchInput1 then
        local touchPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = touchPos - centerPos1
        if delta.Magnitude > maxRadius1 then
            delta = delta.Unit * maxRadius1
        end
        JoystickThumb.Position = UDim2.new(0.5, delta.X - 25, 0.5, delta.Y - 25)
        local dir = delta / maxRadius1
        virtualMoveVector1 = Vector3.new(dir.X, 0, dir.Y)
    end
end)

local function resetJoystick1()
    joystickTouchInput1 = nil
    JoystickThumb.Position = UDim2.new(0.5, -25, 0.5, -25)
    virtualMoveVector1 = Vector3.new()
end

UserInputService.InputEnded:Connect(function(input)
    if input == joystickTouchInput1 then resetJoystick1() end
end)

-- SWIPE ROTASI LAYAR KANAN
UserInputService.TouchMoved:Connect(function(touch, gpe)
    if isActive1 and not gpe and touch.Position.X > CurrentCamera.ViewportSize.X / 2 then
        local delta = touch.Delta
        touchRotationDelta1 = Vector2.new(-delta.Y * 0.5 * rotSensitivity1, -delta.X * 0.5 * rotSensitivity1)
    end
end)

-- 6. CORE FREECAM1 RENDER LOOP
local function onStepRender1()
    local camCF = CurrentCamera.CFrame

    -- Target FOV & DoF Spring
    fovSpring1.t = baseFov / zoomMultiplier1
    dofSpring1.t = dofDistance1

    rotSpring1.t = touchRotationDelta1
    posSpring1.t = virtualMoveVector1 * moveSpeed1

    touchRotationDelta1 = Vector2.new()

    local currentFov = fovSpring1:Update(renderDelta1)
    local currentPos = posSpring1:Update(renderDelta1) * Vector3.new(1, 0.75, 1)
    local currentRot = rotSpring1:Update(renderDelta1)
    local currentDof = dofSpring1:Update(renderDelta1)

    -- Update Effect DoF di Lighting
    local dofObj = Lighting:FindFirstChild("DOF_Effect1")
    if dofObj then
        dofObj.FocusDistance = currentDof
        dofObj.Enabled = dofEnabled1
    end

    local aspect = Vector2.new(0.85, 1) / 128
    local radFov = currentFov * math.pi / 360
    local rotDelta = currentRot * (aspect * math.tan(radFov) * 0.7002)

    cameraAngles1 = cameraAngles1 + rotDelta
    cameraAngles1 = Vector2.new(math.clamp(cameraAngles1.X, -1.5, 1.5), cameraAngles1.Y)

    local targetCF = CFrame.new(camCF.Position) 
        * CFrame.Angles(0, cameraAngles1.Y, 0) 
        * CFrame.Angles(cameraAngles1.X, 0, 0) 
        * CFrame.new(currentPos)

    CurrentCamera.CFrame = targetCF
    CurrentCamera.Focus = targetCF * CFrame.new(0, 0, -16)
    CurrentCamera.FieldOfView = currentFov

    updateIndicators()
end

RunService.RenderStepped:Connect(function(dt) renderDelta1 = dt end)

local function stopFreecam1()
    isActive1 = false
    JoystickFrame.Visible = false
    ControlPanel.Visible = false
    IndicatorBar.Visible = false
    resetJoystick1()

    local dofObj = Lighting:FindFirstChild("DOF_Effect1")
    if dofObj then dofObj:Destroy() end

    maidInstance1:Sweep()
    RunService:UnbindFromRenderStep("Freecam1Logic")

    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = false
    end

    CurrentCamera.FieldOfView = baseFov
    CurrentCamera.CameraType = Enum.CameraType.Custom
end

local function startFreecam1()
    -- Pasang Efek Depth of Field
    local dof = Instance.new("DepthOfFieldEffect")
    dof.Name = "DOF_Effect1"
    dof.FarIntensity = 0.35
    dof.InFocusRadius = 15
    dof.NearIntensity = 0.75
    dof.FocusDistance = dofDistance1
    dof.Parent = Lighting

    JoystickFrame.Visible = true
    ControlPanel.Visible = true
    IndicatorBar.Visible = true
    CurrentCamera.CameraType = Enum.CameraType.Scriptable

    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = true
    end

    posSpring1.t, posSpring1.v, posSpring1.x = Vector3.new(), Vector3.new(), Vector3.new()
    rotSpring1.t, rotSpring1.v, rotSpring1.x = Vector2.new(), Vector2.new(), Vector2.new()
    fovSpring1.t, fovSpring1.v, fovSpring1.x = baseFov / zoomMultiplier1, 0, baseFov / zoomMultiplier1

    local lookVec = CurrentCamera.CFrame.LookVector.Unit
    cameraAngles1 = Vector2.new(math.asin(lookVec.Y), math.atan2(-lookVec.Z, lookVec.X) - math.pi / 2)

    RunService:BindToRenderStep("Freecam1Logic", Enum.RenderPriority.Camera.Value, onStepRender1)
    isActive1 = true
end

MobileToggleButton.MouseButton1Click:Connect(function()
    if isActive1 then
        stopFreecam1()
    else
        startFreecam1()
    end
end)
