local isActive1 = false
local moveSpeed1 = 1.0
local cameraAngles1 = Vector2.new()
local touchRotationDelta1 = Vector2.new()
local virtualMoveVector1 = Vector3.new()

local posSpring1 = Spring1.new(0.77, 0.33, 1, Vector3.new())
